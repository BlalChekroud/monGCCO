{% extends 'base.html.twig' %}

{% block title %}{{'collect.title'|trans }}{% endblock %}

{% block body %}

<main id="main" class="main">

    <div class="pagetitle">
      <h1>{{'collect.title'|trans }}</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="{{ path('home') }}"><i class="ri-home-4-line"></i> {{ 'breadcrumb_home'|trans }}</a></li>
          <li class="breadcrumb-item active">{{ 'collect.manage'|trans }}</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
      <div class="row">
        <div class="col-lg-12">

          <div class="card">
            <div class="card-body">
              <h5 class="card-title">{{ 'card_title'|trans }}</h5>

                <table class="table datatable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>{{'collector'|trans }}</th>
                            <th>{{'site_collection.siteName'|trans }}</th>
                            <th>{{'species_statistics.total_count'|trans }}</th>
                            <th>{{ 'condition.condition_number'|trans }}</th>
                            <th>{{ 'created_at'|trans }}</th>
                            <th>{{ 'actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for collected_datum in collected_datas|reverse %}
                        <tr>
                            <td>{{ collected_datum.id }}</td>
                            <td>{{ collected_datum.createdBy.name ?? ''}} {{ collected_datum.createdBy.lastName ?? ''}}</td>
                            <td>{{ collected_datum.siteCollection.siteName }}</td>
                            <td>
                              {% if collected_datum.totalCount > 0 %}
                                  <span class="badge bg-info">{{ collected_datum.totalCount ?? 0}}</span>
                              {% else %}
                                  0 
                              {% endif %}
                            </td>
                            <td>{{ collected_datum.environmentalConditions.id ?? ''}}</td>
                            <td>{{ collected_datum.createdAt ? collected_datum.createdAt|date('d-m-Y') : '' }}</td>
                            <td>
                                <div class="d-flex justify-content-end">
                                  {% import 'macros/btn_actions_macros.html.twig' as macros %}
                                  {{ macros.action_buttons('app_collected_data_new','app_collected_data_show', 'app_collected_data_edit', 'collected_data/_delete_form.html.twig', collected_datum, app.request.attributes.get('_route'), true) }}
                                  {{ include('collected_data/_delete_form.html.twig') }}
                              </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6">{{ 'no_record_found'|trans }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="card-footer">
              <a href="{{ path('app_nature_reserve_index') }}" class="btn btn-outline-info btn-sm bi bi-list-task mx-1"> {{'consult_reserves'|trans }}</a>
              <a href="{{ path('app_counting_campaign_index') }}" class="btn btn-outline-info btn-sm bi bi-list-task mx-1"> {{ 'campaign.consult'|trans }}</a>
              <a href="{{ path('app_environmental_conditions_index') }}" class="btn btn-outline-info btn-sm bi bi-list-task mx-1" title="{{'condition.list_environmental_conditions'|trans }}"> {{ 'condition.consult'|trans }}</a>
              <a href="{{ path('app_counting_campaign_new') }}" class="btn btn-outline-info btn-sm bi bi-plus-circle-dotted mx-1"> {{ 'campaign.create_campaign'|trans }}</a>
            </div>
          </div>

        </div>
      </div>
    </section>
    
    {# {% import 'macros/form_macros.html.twig' as form_macros %}
    {{ form_macros.csv_import_form(formExport, 'app_collected_data_index', formExport, 'Import collected Data', 'Export collected Data') }} #}
    {% import 'macros/show_export_macros.html.twig' as macros %}
    {{ macros.export_section(formExport, 'Export collected Data') }}
{# 
    {% if headers is defined and rows is defined %}
        {{ form_macros.csv_modal(headers, rows, csvData, 'app_collected_data_index', ['country', 'iso2']) }}
    {% endif %} #}

</main><!-- End #main -->
{% endblock %}
