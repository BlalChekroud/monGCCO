{% if is_granted('ROLE_COLLECTOR') %}
<form method="post" action="{{ path('app_collected_data_delete', {'id': collected_datum.id}) }}" onsubmit="return confirm('{{ 'delete_confirm'|trans }}');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ collected_datum.id) }}">
    <button class="btn btn-danger btn-sm bi bi-trash mx-2" title="{{ 'collect.delete'|trans }}"></button>
</form>
{% endif %}