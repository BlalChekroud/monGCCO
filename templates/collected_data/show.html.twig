{% extends 'base.html.twig' %}

{% block title %}{{'collect.title'|trans }}{% endblock %}

{% block body %}
<main id="main" class="main">

    <div class="pagetitle">
      <h1>{{'collect.title_show'|trans }}</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="{{ path('home') }}"><i class="ri-home-4-line"></i> {{ 'breadcrumb_home'|trans }}</a></li>
          <li class="breadcrumb-item"><a href="{{ path('app_collected_data_index') }}">{{ 'collect.manage'|trans }}</a></li>
          <li class="breadcrumb-item active">{{'show'|trans }}</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
        <div class="row">
            <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">

                <div class="card">
                  <div id="printableArea">
                    <div class="card-body">
                        <h5 class="card-title">{{'show'|trans }}</h5>

                        <table class="table">
                            <tbody>
                                <tr>
                                    <th style="width: 30%; white-space: nowrap;">{{'campaign.name'|trans }}:</th>
                                    <td style="width: 70%;">
                                        {% if collected_datum.countingCampaign %}
                                            <div>{{ collected_datum.countingCampaign.campaignName }} <i class="explanation">({{ collected_datum.countingCampaign.campaignStatus }})</i></div>
                                        {% else %}
                                            <p>{{'campaign.none'|trans }}</p>
                                        {% endif %}
                                    </td>
                                </tr>
                                <tr>
                                    <th style="width: 30%; white-space: nowrap;">{{'group.name'|trans }} :</th>
                                    <td style="width: 70%;">
                                        {% if teamLeader %}
                                            {{ teamLeader.groupName ?? '' }}
                                        {% endif %}
                                    </td>
                                </tr>
                                 <tr>
                                    <th style="width: 30%; white-space: nowrap;">{{'group_leader'|trans }} :</th>
                                    <td style="width: 70%;">
                                        {% if teamLeader %}
                                            {{ teamLeader.email ?? ''}}
                                        {% endif %}
                                    </td>
                                </tr>
                                <tr>
                                    <th style="width: 30%; white-space: nowrap;">{{'collector'|trans }} :</th>
                                    <td style="width: 70%;">{{ collected_datum.createdBy.name ?? '' }} {{ collected_datum.createdBy.lastName ?? '' }}</td>
                                </tr>
                                <tr>
                                    <th style="width: 30%; white-space: nowrap;">{{'site_collection.siteName'|trans }} :<h6>({{'city.name'|trans }})</h6></th>
                                    <td style="width: 70%;">
                                        {% if collected_datum.siteCollection %}
                                            {{ collected_datum.siteCollection.siteName }}<h6>({{ collected_datum.siteCollection.city.name }})</h6>
                                        {% else %}
                                            <p>{{'site_collection.none'|trans }}</p>
                                        {% endif %}
                                    </td>
                                </tr>
                                {% if collected_datum.environmentalConditions is not empty %}
                                    <tr>
                                        <th style="width: 30%; white-space: nowrap;">{{'conditionDisturbed.description'|trans }} <h6>({{'conditionDisturbed.explanation'|trans }}):</h6></th>
                                        <td style="width: 70%;">{{ collected_datum.environmentalConditions.disturbed.label ?? ''}}</td>
                                    </tr>
                                    <tr>
                                        <th style="width: 30%; white-space: nowrap;">{{'conditionWeather.description'|trans }} <h6>{{'conditionWeather.explanation'|trans }} :</h6></th>
                                        <td style="width: 70%;">{{ collected_datum.environmentalConditions.weather.label ?? ''}}</td>
                                    </tr>
                                    <tr>
                                        <th style="width: 30%; white-space: nowrap;">{{'conditionWater.description'|trans }}:</th>
                                        <td style="width: 70%;">{{ collected_datum.environmentalConditions.water.label }}</td>
                                    </tr>
                                    <tr>
                                        <th style="width: 30%; white-space: nowrap;">{{'conditionIce.description'|trans }}:</th>
                                        <td style="width: 70%;">{{ collected_datum.environmentalConditions.ice.label ?? ''}}</td>
                                    </tr>
                                    <tr>
                                        <th style="width: 30%; white-space: nowrap;">{{'conditionTidal.description'|trans }}:</th>
                                        <td style="width: 70%;">{{ collected_datum.environmentalConditions.tidal.label ?? ''}}</td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <th style="width: 30%; white-space: nowrap;">{{'collect.conditions_environment'|trans }}</th>
                                        <td>{{ 'no_record_found'|trans }}</td>
                                    </tr>
                                {% endif %}
                                <tr>
                                    <th style="width: 20%; white-space: nowrap;">{{'collect.species_count'|trans }} :</th> 
                                    <td style="width: 80%;"> 
                                        <table class="table table-striped">
                                            <thead>
                                                <tr>
                                                    <th style="width: 80%; white-space: nowrap;">{{'species_statistics.species'|trans }}</th>
                                                    <th style="width: 20%; white-space: nowrap; text-align: center;">{{'collect.count'|trans }}</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {% for specy, count in collected_datum.getCountBySpecies %}
                                                    <tr>
                                                        <td style="width: 80%;">{{ specy }}</td>
                                                        <td style="width: 20%; text-align: center;">{{ count }}</td>
                                                    </tr>
                                                {% else %}
                                                    <tr>
                                                        <td colspan="2" style="text-align: center;">{{'campaign_statistics.no_species_observed'|trans }}</td>
                                                    </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                                <tr>
                                    <th style="width: 30%; white-space: nowrap;">{{'species_statistics.total_count'|trans }}:</th>
                                    <td style="width: 70%;">{{ collected_datum.totalCount ?? 0 }}</td>
                                </tr>
                                <tr>
                                    <th style="width: 30%; white-space: nowrap;">{{'countType.label'|trans }}</th>
                                    <td style="width: 70%;">{{ collected_datum.countType.label ?? ''}}</td>
                                </tr>
                                <tr>
                                    <th style="width: 30%; white-space: nowrap;">{{'quality'|trans }}:</th>
                                    <td style="width: 70%;">{{ collected_datum.quality.label ?? ''}}</td>
                                </tr>
                                <tr>
                                    <th style="width: 30%; white-space: nowrap;">{{'method.label'|trans }}</th>
                                    <td style="width: 70%;">{{ collected_datum.method|join('<br> ')|raw }}</td>
                                </tr>
                                <tr>
                                    <th style="width: 30%; white-space: nowrap;">{{ 'created_at'|trans }}</th>
                                    <td style="width: 70%;">{{ collected_datum.createdAt ? collected_datum.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                                </tr>
                                <tr>
                                    <th style="width: 30%; white-space: nowrap;">{{ 'Last_updated_at'|trans }}</th>
                                    <td style="width: 70%;">{{ collected_datum.updatedAt ? collected_datum.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                  </div>
                    <div class="card-footer d-flex justify-content-between">
                        <div>
                            <a href="{{ path('app_collected_data_index') }}" class="btn btn-sm btn-outline-secondary" title="{{ 'collect.return'|trans }}">{{ 'back'|trans }}</a>
                            {% if collected_datum.environmentalConditions %}
                                <a href="{{ path('app_environmental_conditions_show', {'id': collected_datum.environmentalConditions.id}) }}" class="btn btn-outline-success btn-sm bi bi-card-text mx-2" title="{{'condition.title_show'|trans }}"> {{'campaign_statistics.environmental_conditions'|trans }}</a>
                            {% endif %}
                            {% if collected_datum.countingCampaign %}
                                <a href="{{ path('app_counting_campaign_show', {'id': collected_datum.countingCampaign.id}) }}" class="btn btn-outline-success btn-sm bi bi-card-text mx-1" title="{{'campaign.campaign_details'|trans }}"> {{'campaign.name'|trans }}</a>
                            {% endif %}
                            <a href="{{ path('app_collected_data_new') }}" class="btn btn-outline-info btn-sm bi bi-plus-circle-dotted mx-1"> {{'collect.collect_add'|trans }}</a>
                        </div>
                        <div class="d-flex justify-content-end">
                            {% import 'macros/btn_actions_macros.html.twig' as macros %}
                            {{ macros.action_buttons('app_collected_data_new','app_collected_data_show', 'app_collected_data_edit', 'collected_data/_delete_form.html.twig', collected_datum, app.request.attributes.get('_route')) }}
                            {{ include('collected_data/_delete_form.html.twig') }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
{% endblock %}
