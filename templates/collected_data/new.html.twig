{% extends 'base.html.twig' %}

{% block title %}{{'collect.title'|trans }}{% endblock %}

{% block body %}

<main id="main" class="main">

    <div class="pagetitle">
      <h1>{{ 'collect.title_add'|trans }}</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="{{ path('home') }}"><i class="ri-home-4-line"></i> {{ 'breadcrumb_home'|trans }}</a></li>
          <li class="breadcrumb-item"><a href="{{ path('app_collected_data_index') }}">{{ 'collect.manage'|trans }}</a></li>
          <li class="breadcrumb-item active">{{ 'add'|trans }}</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
        <div class="row">
            <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">

                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div class="card-title">{{ 'collect.informations'|trans }}</div>
                            <div class="card-title">
                                <div class="explanation">{{ siteCollection.siteName }}</div>
                            </div>
                        </div>

                        {{ include('collected_data/_form.html.twig') }}
                    </div>
                    <div class="card-footer">
                        <a href="{{ path('app_collected_data_index') }}" class="btn btn-sm btn-outline-secondary" title="{{ 'collect.return'|trans }}">{{ 'back'|trans }}</a>
                        <a href="{{ path('app_environmental_conditions_show', {'id': environmentalConditions.id}) }}" class="btn btn-outline-success btn-sm bi bi-card-text mx-2" title="{{ 'condition.list_environmental_conditions'|trans }}"> {{'collect.collection_environmental_condition'|trans }}</a>
                        <a href="{{ path('app_counting_campaign_show', {'id': campaign_id}) }}" class="btn btn-outline-success btn-sm bi bi-card-text mx-1" title="{{'campaign.campaign_details'|trans}}"> {{'campaign.name'|trans }}</a>
                        <a href="{{ path('app_counting_campaign_new') }}" class="btn btn-outline-info btn-sm bi bi-plus-circle-dotted mx-1"> {{ 'campaign.create_campaign'|trans }}</a>
                        <a href="{{ path('app_bird_species_new') }}" class="btn btn-outline-info btn-sm bi bi-plus-circle-dotted mx-1"> {{'create_a_species'|trans }}</a>
                    </div>
                </div>

            </div>

        </div>
    </section>
</main>
{% endblock %}
