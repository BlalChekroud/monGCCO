{% if is_granted('ROLE_ADMIN') %}
    <form method="post" action="{{ path('app_nature_reserve_delete', {'id': nature_reserve.id}) }}" onsubmit="return confirm('{{ 'delete_confirm'|trans }}');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ nature_reserve.id) }}">
        <button class="btn btn-danger btn-sm bi bi-trash mx-2" title="{{ 'nature_reserve.delete'|trans }}"></button>
    </form>
{% endif %}