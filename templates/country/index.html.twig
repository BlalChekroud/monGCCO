{% extends 'base.html.twig' %}

{% block title %}{{'country.title'|trans }}{% endblock %}

{% block body %}
  <main id="main" class="main">

    <div class="pagetitle">
      <h1>{{'country.title'|trans }}</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="{{ path('home') }}"><i class="ri-home-4-line"></i> {{ 'breadcrumb_home'|trans }}</a></li>
          <li class="breadcrumb-item active">{{ 'country.manage'|trans }}</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
      <div class="row">
        <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
          <div class="card">
            <div class="card-body">
              <h5 class="card-title">{{ 'card_title'|trans }}</h5>
             <div id="printableArea">
                <!-- Table with stripped rows -->
                <table class="table datatable">
                    <thead>
                        <tr>
                            <th>{{ 'country.name'|trans }}</th>
                            <th>{{ 'country.iso'|trans }}</th>
                            <th>{{ 'regions'|trans }}</th>
                            <th>{{ 'created_at'|trans }}</th>
                            <th>{{ 'actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for country in countries %}
                        <tr>
                            <td>
                                <button class="btn btn-link" type="button" data-bs-toggle="collapse" data-bs-target="#collapse{{ country.id }}" aria-expanded="false" aria-controls="collapse{{ country.id }}" title="{{'country.viewCities'|trans }}">
                                    {{ country.name }}
                                </button>
                            </td>
                            <td>{{ country.iso2 }}</td>
                            <td>
                                <div class="collapse" id="collapse{{ country.id }}">
                                    <div class="accordion-body">
                                        {% if country.regions|length > 0 %}
                                            {% set sorted_regions = country.regions|sort((a, b) => a.name <=> b.name) %}
                                            <ul>
                                                {% for region in sorted_regions %}
                                                    <li>{{ region.name }}</li>
                                                {% endfor %}
                                            </ul>
                                        {% else %}
                                            <p>{{ 'region.none'|trans }}</p>
                                        {% endif %}
                                    </div>
                                </div>
                            </td>
                            <td>{{ country.createdAt ? country.createdAt|date('d-m-Y') : '' }}</td>
                            <td>
                                <div class="d-flex justify-content-end">
                                    {% import 'macros/btn_actions_macros.html.twig' as macros %}
                                    {{ macros.action_buttons('app_country_new','app_country_show', 'app_country_edit', 'country/_delete_form.html.twig', country, app.request.attributes.get('_route'), true) }}
                                    {{ include('country/_delete_form.html.twig') }}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7">{{ 'no_record_found'|trans }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
              <!-- End Table with stripped rows -->    
             </div>          
              
            </div>
            <div class="card-footer">
              <a href="{{ path('app_country_new') }}" class="btn btn-outline-info btn-sm bi bi-plus-circle-dotted"> {{'add_a_country'|trans }}</a>
              <a href="{{ path('app_region_index') }}" class="btn btn-outline-info btn-sm bi bi-list-task mx-1"> {{'region.consult'|trans }}</a>
              <a href="{{ path('app_region_new') }}" class="btn btn-outline-info btn-sm bi bi-plus-circle-dotted mx-1"> {{'add_a_region'|trans }}</a>
              <a href="{{ path('app_city_index') }}" class="btn btn-outline-info btn-sm bi bi-list-task mx-1"> {{'city.consult'|trans }}</a>
              <a href="{{ path('app_city_new') }}" class="btn btn-outline-info btn-sm bi bi-plus-circle-dotted mx-1"> {{'add_a_city'|trans }}</a>
            </div>
          </div>

        </div>
      </div>
    </section>

    {% import 'macros/form_macros.html.twig' as form_macros %}
    {{ form_macros.csv_import_form(form, 'app_country_index', formExport, 'Import countries Data', 'Export countries Data') }}


    {% if headers is defined and rows is defined %}
        {{ form_macros.csv_modal(headers, rows, csvData, 'app_country_index', ['country', 'iso2']) }}
    {% endif %}

  </main><!-- End #main -->
{% endblock %}
