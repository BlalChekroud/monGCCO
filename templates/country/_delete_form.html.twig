{% if is_granted('ROLE_DELETE') %}
    <form method="post" action="{{ path('app_country_delete', {'id': country.id}) }}" onsubmit="return confirm('{{ 'delete_confirm'|trans }}');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ country.id) }}">
        <button class="btn btn-danger btn-sm bi bi-trash mx-2" title="{{ 'country.delete'|trans }}"></button>
    </form>
{% endif %}
