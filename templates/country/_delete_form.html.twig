{% if is_granted('ROLE_DELETE') %}
    <form method="post" action="{{ path('app_country_delete', {'id': country.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet élément ?');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ country.id) }}">
        <button class="btn btn-danger btn-sm bi bi-trash mx-2" title="Supprimer"></button>
    </form>
{% endif %}
