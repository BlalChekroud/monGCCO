{% extends 'base.html.twig' %}

{% block title %}{{'image.title'|trans }}{% endblock %}

{% block body %}
  <main id="main" class="main">

    <div class="pagetitle">
      <h1>{{ 'image.title_edit'|trans }}</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="{{ path('home') }}"><i class="ri-home-4-line"></i> {{ 'breadcrumb_home'|trans }}</a></li>
          <li class="breadcrumb-item"><a href="{{ path('app_image_index') }}">{{ 'image.manage'|trans }}</a></li>
          <li class="breadcrumb-item active">{{ 'modification'|trans }}</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
      <div class="row">
        <div class="col-sm-10 col-md-10 col-lg-10 col-xl-10">

          <div class="card">
            <div class="card-body">
              <h5 class="card-title">{{ 'image.the_new_informations'|trans }}</h5>

              {{ include('image/_form.html.twig') }}

            </div>
            <div class="card-footer">
              <div class="d-flex justify-content-between">
                <a href="{{ path('app_image_index') }}" class="btn btn-sm btn-outline-secondary" title="{{ 'image.return'|trans }}">{{ 'back'|trans }}</a>
                {{ include('image/_delete_form.html.twig') }}
              </div>
            </div>
          </div>

        </div>

      </div>
    </section>

  </main><!-- End #main -->
{% endblock %}
