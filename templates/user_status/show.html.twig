        </tbody>
    </table>

    <a href="{{ path('app_user_status_index') }}">back to list</a>

    <a href="{{ path('app_user_status_edit', {'id': user_status.id}) }}">edit</a>

    {{ include('user_status/_delete_form.html.twig') }}
