{% extends 'base.html.twig' %}

{% block title %}UserStatus{% endblock %}

{% block body %}
    <h1>UserStatus</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ user_status.id }}</td>
            </tr>
            <tr>
                <th>Label</th>
                <td>{{ user_status.label }}</td>
