{% extends 'base.html.twig' %}

{% block title %}{{ 'userStatus.title'|trans }}{% endblock %}

{% block body %}
    <a href="{{ path('app_user_status_new') }}">Create new</a>
  <main id="main" class="main">

    <div class="pagetitle">
      <h1>{{ 'userStatus.title'|trans }}</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="{{ path('home') }}"><i class="ri-home-4-line"></i> {{ 'breadcrumb_home'|trans }}</a></li>
          <li class="breadcrumb-item active">{{ 'userStatus.breadcrumb_management'|trans }}</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
      <div class="row">
        <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
          <div class="card">
            <div class="card-body">
              <h5 class="card-title">{{ 'card_title'|trans }}</h5>
              <div id="printableArea">
                <!-- Table with stripped rows -->
                <table class="table datatable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>{{ 'userStatus.label'|trans }}</th>
                            <th>{{ 'created_at'|trans }}</th>
                            <th>{{ 'Last_updated_at'|trans }}</th>
                            <th>{{ 'actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user_status in user_statuses %}
                            <tr>
                                <td>{{ user_status.id }}</td>
                                <td>{{ user_status.label }}</td>
                                <td>{{ user_status.createdAt ? user_status.createdAt|date('d-m-Y H:i:s') : '' }}</td>
                                <td>{{ user_status.updatedAt ? user_status.updatedAt|date('d-m-Y H:i:s') : '' }}</td>
                                <td>
                                    <div class="d-flex justify-content-end">
                                        {% import 'macros/btn_actions_macros.html.twig' as macros %}
                                        {{ macros.action_buttons('app_user_status_new','home', 'app_user_status_edit', 'user_status/_delete_form.html.twig', user_status, app.request.attributes.get('_route')) }}
                                        {{ include('user_status/_delete_form.html.twig') }}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5">{{ 'no_record_found'|trans }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                <!-- End Table with stripped rows -->    
              </div>          
            </div>
            <div class="card-footer">
              <a href="{{ path('app_user_status_new') }}" class="btn btn-outline-info btn-sm bi bi-plus-circle-dotted"> {{ 'create_user_status'|trans }}</a>
              <a href="{{ path('app_nature_reserve_index') }}" class="btn btn-outline-info btn-sm bi bi-list-task mx-1"> {{ 'consult_reserves'|trans }}</a>
              <a href="{{ path('app_counting_campaign_index') }}" class="btn btn-outline-info btn-sm bi bi-list-task mx-1"> {{ 'consult_campaigns'|trans }}</a>
            </div>
          </div>

        </div>
      </div>
    </section>

  </main><!-- End #main -->
{% endblock %}
