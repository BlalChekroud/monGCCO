{% if is_granted('ROLE_USER') %}
    <form method="post" action="{{ path('notification_delete', {'id': notification.id}) }}" onsubmit="return confirm('{{ 'delete_confirm'|trans }}');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ notification.id) }}">
        <button class="btn btn-danger btn-sm bi bi-trash-fill mx-2" title="{{ 'notification.delete'|trans }}"></button>
    </form>
{% endif %}