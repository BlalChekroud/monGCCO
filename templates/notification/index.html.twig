{% extends 'base.html.twig' %}

{% block title %}{{ 'notification.all'|trans }}{% endblock %}

{% block body %}
  <main id="main" class="main">

    <div class="pagetitle">
      <h1>{{ 'notification.all'|trans }}</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="{{ path('home') }}"><i class="ri-home-4-line"></i> {{ 'breadcrumb_home'|trans }}</a></li>
          <li class="breadcrumb-item active">{{ 'notification.manage_notifications'|trans }}</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
      <div class="row">
        <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
          
          <div class="notifications-containerhg">
              <div class="notifications-header">
                  <h3>
                    {{ 'notification.your_notifications'|trans }} 
                    {% if unreadNotifications %}
                        <div class="explanation badge bg-light badge-number">{{ unreadNotifications }}</div> 
                        <span class="explanation">{{ 'notification.unread_notifications'|trans }}</span>
                    {% endif %}
                </h3>
              </div>
              <div class="card">
                  <div class="card-body">
                      <ul class="notifications-list">
                          {% if app.user.notifications|length > 0 %}
                              {% for notification in app.user.notifications|reverse %}
                                  <li class="notification-item">
                                      <div class="notification-content">
                                          <p class="notification-message">{{ notification.message }}</p>
                                          <p class="notification-time">
                                              {{ notification.createdAt ? notification.createdAt|date('d-m-Y H:i:s') : '' }}
                                          </p>
                                          <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 d-flex justify-content-between">
                                            <div class="d-flex justify-content-start">
                                              {# Ajoutez un lien pour marquer comme vu #}
                                              {% if not notification.seen %}
                                                  <a href="{{ path('notification_mark_as_seen', { 'id': notification.id }) }}" class="mark-as-seen btn btn-sm" data-id="{{ notification.id }}">
                                                    {{ 'notification.mark_as_seen'|trans }}
                                                  </a>
                                              {% endif %}
                                            </div>
                                            <div class="d-flex justify-content-end">
                                              {{ include('notification/_delete_form.html.twig') }}
                                            </div>
                                          </div>
                                      </div>
                                  </li>
                              {% else %}
                                  <li class="no-notifications">{{ 'no_record_found'|trans }}</li>
                              {% endfor %}
                          {% else %}
                              <li class="no-notifications">{{ 'no_record_found'|trans }}</li>
                          {% endif %}
                      </ul>
                  </div>
              </div>
          </div>

        </div>
      </div>
    </section>

  </main><!-- End #main -->
