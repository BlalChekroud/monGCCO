{% if is_granted('ROLE_SUPER_ADMIN') %}
<form id="delete-form" method="post" action="{{ path('app_logo_delete', {'id': logo.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ logo.id) }}">
    <button type="button" onclick="confirmDelete()" class="btn btn-danger btn-sm bi bi-trash mx-2" title="{{ 'logo.delete'|trans }}"></button>
</form>
{% endif %}
<script>
    function confirmDelete() {
        const swalWithBootstrapButtons = Swal.mixin({
            customClass: {
                confirmButton: 'btn btn-success swal2-button-space',
                cancelButton: 'btn btn-danger swal2-button-space'
            },
            buttonsStyling: false
        });

        swalWithBootstrapButtons.fire({
            title: "{{'sweetalert.confirm_title'|trans }}",
            text: "{{'sweetalert.confirm_text'|trans }}",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: "{{'sweetalert.confirm_button'|trans }}",
            cancelButtonText: "{{'sweetalert.cancel_button'|trans }}",
            reverseButtons: true
        }).then((result) => {
            if (result.isConfirmed) {
                // Soumettre le formulaire si l'utilisateur confirme la suppression
                document.getElementById('delete-form').submit();
                swalWithBootstrapButtons.fire({
                    title: "{{'sweetalert.deleted_title'|trans }}",
                    text: "{{'sweetalert.deleted_text'|trans }}",
                    icon: 'success'
                });
            } else if (result.dismiss === Swal.DismissReason.cancel) {
                swalWithBootstrapButtons.fire({
                    title: "{{'sweetalert.cancelled_title'|trans }}",
                    text: "{{'sweetalert.cancelled_text'|trans }}",
                    icon: 'error'
                });
            }
        });
    }
</script>