{% extends 'base.html.twig' %}

{% block title %}{{'logo.title'|trans }}{% endblock %}

{% block body %}
  <main id="main" class="main">

    <div class="pagetitle">
      <h1>{{ 'logo.title_add'|trans }}</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="{{ path('home') }}"><i class="ri-home-4-line"></i> {{ 'breadcrumb_home'|trans }}</a></li>
          <li class="breadcrumb-item"><a href="{{ path('app_logo_index') }}">{{ 'logo.manage'|trans }}</a></li>
          <li class="breadcrumb-item active">{{ 'add'|trans }}</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
      <div class="row">
        <div class="col-sm-11 col-md-11 col-lg-11 col-xl-11">

          <div class="card">
            <div class="card-body">
              <h5 class="card-title">{{ 'logo.informations'|trans }}</h5>

              {{ include('logo/_form.html.twig') }}

            </div>
            <div class="card-footer">
              <a href="{{ path('app_logo_index') }}" class="btn btn-sm btn-outline-secondary mx-1" title="{{ 'logo.return'|trans }}">{{ 'back'|trans }}</a>
            </div>
          </div>

        </div>

      </div>
    </section>

  </main><!-- End #main -->
{% endblock %}
