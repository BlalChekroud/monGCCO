{% if is_granted('ROLE_DELETE') %}
    <form method="post" action="{{ path('app_iucn_red_list_category_delete', {'id': iucn_red_list_category.id}) }}" onsubmit="return confirm('{{ 'delete_confirm'|trans }}');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ iucn_red_list_category.id) }}">
        <button class="btn btn-danger btn-sm bi bi-trash-fill mx-2" title="{{ 'iucn.delete'|trans }}"></button>
    </form>
{% endif %}