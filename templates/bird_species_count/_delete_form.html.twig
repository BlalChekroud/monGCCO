{% if is_granted('ROLE_DELETE') %}
    <form method="post" action="{{ path('app_bird_species_count_delete', {'id': bird_species_count.id}) }}" onsubmit="return confirm('{{ 'delete_confirm'|trans }}');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ bird_species_count.id) }}">
        <button class="btn">Delete</button>
    </form>
{% endif %}