{% extends 'base.html.twig' %}

{% block title %}Utilisateurs / Profil{% endblock %}

{% block body %}
  {% if is_granted('IS_AUTHENTICATED_FULLY') %}
    <main id="main" class="main">

      <div class="pagetitle">
        <h1>Profil</h1>
        <nav>
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('home') }}"><i class="ri-home-4-line"></i> {{ 'breadcrumb_home'|trans }}</a></li>
            <li class="breadcrumb-item active">Utilisateurs</li>
          </ol>
        </nav>
      </div><!-- End Page Title -->

      <section class="section">
        <div class="row">
          <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
           <div id="printableArea">
            <div class="card">
              <div class="card-body">
                <h5 class="card-title">{{ 'card_title'|trans }}</h5>
                <table class="table datatable table-striped table table-sm">
                  <thead>
                    <tr>
                      <th>#</th>
                      <th>Nom</th>
                      <th>Prénom</th>
                      <th>Email</th>
                      <th>Rôles</th>
                      <th>État</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    {% for user in users %}
                      <tr>
                        <td>{{ user.id }}</td>
                        <td>{{ user.name }}</td>
                        <td>{{ user.lastName }}</td>
                        <td>{{ user.email }}</td>
                        <td><h6>{{ user.getRoles()|join(', ') }}</h6></td>
                        <td>
                            {{ user.userStatus.label ?? ''}}
                        </td>
                        <td>
                          <div class="d-flex justify-content-center">
                            <a href="{{ path('app_profile_edit', {'id': user.id}) }}" class="btn btn-primary btn-sm bi bi-pencil-square mx-2" title="{{ 'edit'|trans }}"></a>
                            {{ include('security/_delete_form.html.twig')}}
                          </div>
                        </td>
                      </tr>
                    {% else %}
                      <tr>
                        <td colspan="8">Aucun enregistrement trouvé</td>
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            </div>

           </div>
          </div>
        </div>
      </section>

    </main><!-- End #main -->
  {% endif %}
{% endblock %}