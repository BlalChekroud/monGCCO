{% if is_granted('ROLE_ADMIN') %}
    <form method="post" action="{{ path('app_bird_family_delete', {'id': bird_family.id}) }}" onsubmit="return confirm('{{ 'delete_confirm'|trans }}');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ bird_family.id) }}">
        <button class="btn btn-danger btn-sm bi bi-trash-fill mx-2" title="{{ 'birdFamily.delete_family'|trans }}"></button>
    </form>
{% endif %}
