{% extends 'base.html.twig' %}

{% block title %}{{ 'birdFamily.title'|trans }}{% endblock %}

{% block body %}

<main id="main" class="main">

    <div class="pagetitle">
      <h1>{{ 'birdFamily.details_of_a_species_family'|trans }}</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="{{ path('home') }}"><i class="ri-home-4-line"></i> {{ 'breadcrumb_home'|trans }}</a></li>
          <li class="breadcrumb-item"><a href="{{ path('app_bird_family_index') }}">{{ 'birdFamily.manage_families'|trans }}</a></li>
          <li class="breadcrumb-item active">{{ 'show'|trans }}</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
        <div class="row">
            <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
                <div class="card">
                    <div class="card-body">
                     <div id="printableArea">
                        <h5 class="card-title">{{ 'show'|trans }}</h5>

                        <table class="table">
                            <tbody>
                                <tr>
                                    <th>{{ 'birdFamily.family_name'|trans }} :</th>
                                    <td>{{ bird_family.getFamilyName() }}</td>
                                </tr>
                                <tr>
                                    <th>{{ 'birdFamily.family'|trans }} :</th>
                                    <td>{{ bird_family.getFamily() }}</td>
                                </tr>
                                <tr>
                                    <th>{{ 'birdFamily.order'|trans }} :</th>
                                    <td>{{ bird_family.getOrdre() }}</td>
                                </tr>
                                <tr>
                                    <th>{{ 'birdFamily.sub_family'|trans }} :</th>
                                    <td>{{ bird_family.getSubFamily() }}</td>
                                </tr>
                                <tr>
                                    <th>{{ 'birdFamily.tribe'|trans }} :</th>
                                    <td>{{ bird_family.getTribe() }}</td>
                                </tr>
                                <tr>
                                    <th>{{ 'created_at'|trans }}</th>
                                    <td>{{ bird_family.createdAt ? bird_family.createdAt|date('d-m-Y H:i:s') : '' }}</td>
                                </tr>
                                <tr>
                                    <th>{{ 'Last_updated_at'|trans }}</th>
                                    <td>{{ bird_family.updatedAt ? bird_family.updatedAt|date('d-m-Y H:i:s') : '' }}</td>
                                </tr>
                            </tbody>
                        </table>
                     </div>

                    </div>
                    <div class="card-footer">
                        <div class="row">
                            <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 d-flex justify-content-between">
                                <div>
                                    <a href="{{ path('app_bird_family_index') }}" class="btn btn-sm btn-outline-secondary mx-1" title="{{ 'birdFamily.return_to_family_consultation'|trans }}">{{ 'back'|trans }}</a>
                                    <a href="{{ path('app_bird_family_new') }}" class="btn btn-outline-info btn-sm bi bi-plus-circle-dotted mx-1"> {{ 'create_a_family'|trans }}</a>
                                </div>
                                <div class="d-flex justify-content-end">
                                    {% import 'macros/btn_actions_macros.html.twig' as macros %}
                                    {{ macros.action_buttons('app_bird_family_new', 'app_bird_family_show', 'app_bird_family_edit', 'bird_family/_delete_form.html.twig', bird_family, app.request.attributes.get('_route')) }}
                                    {{ include('bird_family/_delete_form.html.twig') }}
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>
    <section class="section py-4">
    {% import 'macros/show_export_macros.html.twig' as macros %}

    {{ macros.export_section(formExport, 'Export Bird Family Data') }}

</main>
{% endblock %}
