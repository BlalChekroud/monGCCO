{% extends 'base.html.twig' %}

{% block title %}{{ 'birdFamily.title'|trans }}{% endblock %}

{% block body %}
  <main id="main" class="main">

    <div class="pagetitle">
      <h1>{{ 'birdFamily.edit_this_family'|trans }}</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="{{ path('home') }}"><i class="ri-home-4-line"></i> {{ 'breadcrumb_home'|trans }}</a></li>
          <li class="breadcrumb-item"><a href="{{ path('app_bird_family_index') }}">{{ 'birdFamily.manage_families'|trans }}</a></li>
          <li class="breadcrumb-item active">{{ 'modification'|trans }}</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
      <div class="row">
        <div class="col-sm-8 col-md-8 col-lg-8 col-xl-8">

          <div class="card">
            <div class="card-body">
              <h5 class="card-title">{{ 'birdFamily.the_new_informations'|trans }}</h5>

              {{ include('bird_family/_form.html.twig') }}

            </div>
            <div class="card-footer">
              <div class="d-flex justify-content-between">
                <div>
                  <a href="{{ path('app_bird_family_index') }}" class="btn btn-sm btn-outline-secondary mx-1" title="{{ 'birdFamily.return_to_family_consultation'|trans }}">{{ 'back'|trans }}</a>
                </div>
                <div class="d-flex justify-content-end">
                  {% import 'macros/btn_actions_macros.html.twig' as macros %}
                  {{ macros.action_buttons('app_bird_family_new', 'app_bird_family_show', 'app_bird_family_edit', 'bird_family/_delete_form.html.twig', bird_family, app.request.attributes.get('_route'), false) }}
                  {{ include('bird_family/_delete_form.html.twig') }}
                </div>
              </div>
            </div>
          </div>

        </div>

      </div>
    </section>

  </main><!-- End #main -->
{% endblock %}
