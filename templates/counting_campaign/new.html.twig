{% extends 'base.html.twig' %}

{% block title %}{{'campaign.title'|trans }}{% endblock %}

{% block body %}

<main id="main" class="main">

    <div class="pagetitle">
      <h1>{{'campaign.title_add'|trans }}</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="{{ path('home') }}"><i class="ri-home-4-line"></i> {{ 'breadcrumb_home'|trans }}</a></li>
          <li class="breadcrumb-item"><a href="{{ path('app_counting_campaign_index') }}">{{ 'campaign.manage'|trans }}</a></li>
          <li class="breadcrumb-item active">{{ 'add'|trans }}</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
      <div class="row">
        <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">

          <div class="card">
            <div class="card-body">
              <h5 class="card-title">{{'campaign.informations'|trans }}</h5>
              {{ include('counting_campaign/_form.html.twig') }}
            </div>
            <div class="card-footer">
              <a href="{{ path('app_counting_campaign_index') }}" class="btn btn-sm btn-outline-secondary mx-1" title="{{ 'campaign.back_to_campaign_consultation'|trans }}">{{ 'back'|trans }}</a>
              <a href="{{ path('app_agents_group_new') }}" class="btn btn-outline-info btn-sm bi bi-plus-circle-dotted mx-1"> {{'create_group'|trans }}</a>
              <a href="{{ path('app_site_collection_new') }}" class="btn btn-outline-info btn-sm bi bi bi-geo-alt-fill mx-1"> {{'site_collection.add_collection_site'|trans }}</a>
            </div>
          </div>
        
        </div>
      </div>
    </section>
</main>
{% endblock %}
