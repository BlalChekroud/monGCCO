<div id="printableArea">
    <!-- Détails de la campagne -->
    <table class="table table-hover table-striped">
        <tr><td><strong>{{ 'campaign.campaign_name'|trans }} :</strong></td><td>{{ counting_campaign.campaignName ?? '' }}</td></tr>
        <tr><td><strong>{{ 'campaign.start_date'|trans }} :</strong></td><td>{{ counting_campaign.startDate ? counting_campaign.startDate|date('d-m-Y H:i:s') : '' }}</td></tr>
        <tr><td><strong>{{ 'campaign.end_date'|trans }} :</strong></td><td>{{ counting_campaign.endDate ? counting_campaign.endDate|date('d-m-Y H:i:s') : '' }}</td></tr>
        <tr><td><strong>{{ 'campaign.status'|trans }} :</strong></td><td>{{ counting_campaign.campaignStatus }}</td></tr>
        <tr><td><strong>{{ 'created_at'|trans }} :</strong></td><td>{{ counting_campaign.createdAt ? counting_campaign.createdAt|date('d-m-Y H:i:s') : '' }}</td></tr>
        <tr><td><strong>{{ 'Last_updated_at'|trans }} :</strong></td><td>{{ counting_campaign.updatedAt ? counting_campaign.updatedAt|date('d-m-Y H:i:s') : '' }}</td></tr>
        <tr><td><strong>{{ 'description'|trans }} :</strong></td><td>{{ counting_campaign.description }}</td></tr>
        <tr><td><strong>{{ 'created_by'|trans }} :</strong></td><td>{{ counting_campaign.createdBy.getEmail }}</td></tr>
    </table>

    <!-- Statistiques de la campagne -->
    <h6 class="mt-4"><i class="bi bi-bar-chart-line-fill"></i> {{ 'campaign_statistics.title'|trans }} :</h6>
    <table class="table table-hover table-bordered table-striped table-sm">
        <thead class="table-dark">
            <tr>
                <th>{{ 'campaign_statistics.statistic'|trans }}</th>
                <th>{{ 'campaign_statistics.value'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><i class="bi bi-geo-alt-fill text-warning"></i> {{ 'campaign_statistics.sites_involved'|trans }}</td>
                <td><span class="badge bg-info">{{ counting_campaign.siteAgentsGroups|length }}</span></td>
            </tr>
            <tr>
                <td><i class="bi bi-person-fill text-success"></i> {{ 'campaign_statistics.total_agents_participating'|trans }}</td>
                <td>
                    <span class="badge bg-success">{{ totalAgentsCount ?? 0 }}</span>
                </td>
            </tr>
            <tr>
                <td><i class="bi bi-file-earmark-bar-graph-fill text-primary"></i> {{ 'campaign_statistics.total_collections'|trans }}</td>
                <td>
                    <span class="badge bg-primary">{{ totalCollectedDataCount ?? 0 }}</span>
                </td>
            </tr>
            <tr>
                <td><i class="bi bi-cloud-sun-fill"></i> {{ 'campaign_statistics.most_frequent_conditions'|trans }}</td>
                <td>
                    <ul>
                        <li>{{ 'disturbed'|trans }} : {{ frequentConditions.disturbed ?? 'Aucune' }}</li>
                        <li>{{ 'ice_cover'|trans }} : {{ frequentConditions.ice ?? 'Aucune' }}</li>
                        <li>{{ 'tidal'|trans }} : {{ frequentConditions.tidal ?? 'Aucune' }}</li>
                        <li>{{ 'water_condition'|trans }} : {{ frequentConditions.water ?? 'Aucune' }}</li>
                        <li>{{ 'campaign_statistics.weather_conditions'|trans }} : {{ frequentConditions.weather ?? 'Aucune' }}</li>
                    </ul>
                </td>
            </tr>
            <tr>
                <td><i class="bi bi-list-ol"></i> {{ 'campaign_statistics.methods_used'|trans }}</td>
                <td>
                    <ul>
                        {% for method in methodsUsed %}
                            <li>{{ method }}</li>
                        {% endfor %}
                    </ul>
                </td>
            </tr>
        </tbody>
    </table>

    <!-- Sites et collectes -->
    <h6 class="mt-4"><i class="bi bi-geo-alt-fill"></i> {{ 'campaign_statistics.sites_and_collections'|trans }} :</h6>
    {% if counting_campaign.siteAgentsGroups|length > 0 %}
        <ol>
        {% for siteAgentsGroup in counting_campaign.siteAgentsGroups %}
            {% set site = siteAgentsGroup.siteCollection %}
            <div class="site-section mb-4">
                <h6 class="mb-3">
                    <li> <i class="bi bi-geo-alt-fill text-warning me-2"></i>{{ 'site_collection.site'|trans }} : {{ site.siteName }} ({{ site.city.name }} / {{ site.city.region.name }})</li>
                </h6>
                <!-- Active Table -->
                <table class="table table-borderless">
                    <thead class="table-dark">
                        <tr>
                            {# <th scope="col">#</th> #}
                            <th scope="col"><i class="bi bi-people-fill"></i> {{ 'campaign.associated_agent_groups'|trans }}</th>
                            <th scope="col"><i class="bi bi-file-earmark-bar-graph-fill"></i> {{ 'campaign_statistics.total_birds_counted'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            {# <th scope="row">{{ loop.index }}</th> #}
                            <td>
                                {% if siteAgentsGroup.agentsGroup|length > 0 %}
                                    <ul>
                                        {% for group in siteAgentsGroup.agentsGroup %}
                                            <li>{{ group.groupName }}; ({{ 'campaign.leader'|trans }}: {{ group.leader.getEmail }})</li>
                                            <ul>
                                                {% for agent in group.groupMember %}
                                                    <li>{{ agent.getEmail }} ({{ agent.name }} {{ agent.lastName }})</li>
                                                {% else %}
                                                    <li>{{ 'campaign_statistics.no_agents_assigned'|trans }}</li>
                                                {% endfor %}
                                            </ul>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <p class="text-muted">{{ 'campaign_statistics.no_groups_found'|trans }}.</p>
                                {% endif %}
                            </td>
                            <td class="d-flex justify-content-center"><span class="badge bg-info"><h5>{{ totalBirdCountsForSiteInCampaign[site.id] ?? 0 }}</h5></span></td>
                        </tr>
                    </tbody>
                </table>
                <!-- End Tables without borders -->

                <!-- Collectes de ce site -->
                {% for collect in site.collectedData %}
                    {% if collect.countingCampaign == counting_campaign %}
                        <h6 class="mt-3"><i class="bi bi-file-earmark-bar-graph-fill"></i> {{ 'campaign_statistics.collection_number'|trans }}: {{ collect.id }} - {{ 'collector'|trans }}: {{ collect.createdBy.getEmail }}</h6>
                        <table class="table table-bordered table-sm">
                            <thead class="table-dark">
                                <tr>
                                    <th>{{ 'campaign_statistics.counting'|trans }}</th>
                                    <th>{{ 'campaign_statistics.environmental_conditions'|trans }}</th>
                                    <th>{{ 'campaign_statistics.observed_species'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <!-- Collecte -->
                                    <td>
                                        <ul>
                                            <li><strong>{{ 'type'|trans }} : </strong> {{ collect.countType.label }}</li>
                                            <li><strong>{{ 'quality'|trans }} : </strong> {{ collect.quality.label }}</li>
                                        </ul>
                                        <span><i class="bi bi-list-ol"></i><strong> {{ 'methods'|trans }}:</strong>
                                            <ul>
                                                {% for method in collect.method %}
                                                    <li>{{ method.label }}</li>
                                                {% else %}
                                                    <span class="text-muted">{{ 'no_method'|trans }}</span>
                                                {% endfor %}
                                            </ul>
                                        </span>
                                    </td>
                                    <!-- Conditions Environnementales -->
                                    <td>
                                        <ul>
                                            <li><strong>{{ 'disturbed'|trans }}:</strong> {{ collect.environmentalConditions.disturbed ?? '' }}</li>
                                            <li><strong>{{ 'weather'|trans }}:</strong> {{ collect.environmentalConditions.weather.label ?? '' }}</li>
                                            <li><strong>{{ 'ice'|trans }}:</strong> {{ collect.environmentalConditions.ice.label ?? '' }}</li>
                                            <li><strong>{{ 'tidal'|trans }}:</strong> {{ collect.environmentalConditions.tidal.label ?? '' }}</li>
                                            <li><strong>{{ 'water'|trans }}:</strong> {{ collect.environmentalConditions.water.label ?? '' }}</li>
                                        </ul>
                                    </td>
                                    <!-- Espèces d'oiseaux observées -->
                                    <td>
                                        <ul>
                                            {% if collect.birdSpeciesCounts|length > 0 %}
                                                {% for species, count in collect.getCountBySpecies %}
                                                    <li>{{ species }}: {{ count }}</li>
                                                {% else %}
                                                    <li class="text-muted">{{ 'campaign_statistics.no_species_observed'|trans }}</li>
                                                {% endfor %}
                                                <strong>Total:</strong> <span class="badge bg-success">{{ collect.totalCount }}</span>
                                            {% else %}
                                                <li class="text-muted">{{ 'campaign_statistics.no_species_observed'|trans }}</li>
                                            {% endif %}
                                        </ul>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    {% endif %}
                {% endfor %}
            </div>
        {% endfor %}
        </ol>
    {% else %}
        <p class="text-muted">{{ 'campaign_statistics.no_sites_found'|trans }}.</p>
    {% endif %}

    <!-- Nombre total compté pour chaque espèce -->
    <h6 class="mt-4"><i class="bi bi-bar-chart-line-fill"></i> {{ 'species_statistics.total_species_counted'|trans }} :</h6>
    {# <table class="table table-hover table-bordered table-striped table-sm">
        <thead class="table-dark">
            <tr>
                <th>{{ 'species_statistics.species'|trans }}</th>
                <th>{{ 'species_statistics.total_count'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for species, count in counting_campaign.getTotalCountBySpecies %}
                <tr>
                    <td><i class="bi bi-twitter text-primary"></i> {{ species }}</td>
                    <td><span class="badge bg-success">{{ count }}</span></td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="2" class="text-center text-muted">
                        <i class="bi bi-exclamation-circle"></i> {{ 'species_statistics.no_species_observed'|trans }}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table> #}
    <table class="table table-hover table-bordered table-striped table-sm">
        <thead class="table-dark">
            <tr>
                <th>{{ 'species_statistics.species'|trans }}</th>
                <th>{{ 'species_statistics.total_count'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for totalCountBySpecie in totalCountBySpecies %}
                <tr>
                    <td><i class="bi bi-twitter text-primary"></i> {{ totalCountBySpecie.species }}</td>
                    <td><span class="badge bg-success">{{ totalCountBySpecie.totalCount }}</span></td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="2" class="text-center text-muted">
                        <i class="bi bi-exclamation-circle"></i> {{ 'species_statistics.no_species_observed'|trans }}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <!-- Total général -->
    <div class="alert alert-primary mt-4 d-flex justify-content-between">
        <div>
            <h6 class="mb-0">
                <i class="bi bi-bar-chart-fill"></i> {{ 'overall_totals.general_count_total'|trans }} :
            </h6>
            <p class="fw-bold fs-4">{{ totalBirdsCountedInCampaign ?? 0 }}</p>
        </div>
        <div>
            <h6 class="mb-0">
                <i class="bx bxs-bar-chart-square"></i> {{ 'overall_totals.unique_species_observed'|trans }} :
            </h6>
            <p class="fw-bold fs-4">{{ totalcountUniqueBirdSpeciesInCampaign ?? 0 }}</p>
        </div>
    </div>
</div>
    <button onclick="window.print()" class="btn btn-sm btn-outline-secondary bi bi-printer" title="{{ 'print'|trans }}"></button>
    {# <a href="{{ path('app_counting_campaign_export', {'id': counting_campaign.id}) }}" class="btn btn-sm btn-outline-secondary bi bi-folder me-3" title="Exporter en CSV"></a> #}
