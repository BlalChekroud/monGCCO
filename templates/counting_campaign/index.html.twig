{% extends 'base.html.twig' %}

{% block title %}{{ 'campaign.title'|trans }}{% endblock %}

{% block body %}

<main id="main" class="main">

    <div class="pagetitle">
      <h1>{{ 'campaign.title'|trans }}</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="{{ path('home') }}"><i class="ri-home-4-line"></i> {{ 'breadcrumb_home'|trans }}</a></li>
          <li class="breadcrumb-item active">{{ 'campaign.manage'|trans }}</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
      <div class="row">
        <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">

          <div class="card">
            <div class="card-body">
              <div class="d-flex justify-content-between">
                <h5 class="card-title">{{ 'card_title'|trans }}</h5>
                
                <button type="button" class="btn btn-sm btn-info bi bi-book" data-bs-toggle="modal" data-bs-target="#largeModal"> {{ 'help'|trans }}</button>
              </div>
              
               <!-- Large Modal for AIDE -->
                <div class="modal fade" id="largeModal" tabindex="-1">
                  <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                      {% include("campaign_status/attention.html.twig") %}
                      <div class="modal-footer">
                          <button type="button" class="btn btn-sm btn-secondary bi bi-x-lg" data-bs-dismiss="modal" title="{{ 'close'|trans }}"></button>
                      </div>
                    </div>
                  </div>
                </div>

              <div id="printableArea">
                <!-- Table with stripped rows -->
                <table class="table datatable">
                  <thead>
                    <tr>
                      <th>#</th>
                      <th>{{ 'campaign.campaign_name'|trans }}</th>
                      <th>{{ 'campaign.start_date'|trans }}</th>
                      <th>{{ 'campaign.end_date'|trans }}</th>
                      <th>{{ 'campaign_remaining_time'|trans }}</th>
                      <th>{{ 'campaign.status'|trans }}</th>
                      <th>{{ 'actions'|trans }}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {# * $campaignStatuses[0] -> "Planifiée"
                    * $campaignStatuses[1] -> "En cours"
                    * $campaignStatuses[2] -> "Terminée"
                    * $campaignStatuses[3] -> "Clôturée"
                    * $campaignStatuses[4] -> "Erreur"
                    * $campaignStatuses[5] -> "Suspendue"
                    * $campaignStatuses[6] -> "Annulée #}
                    {% set status_classes = {
                        0: 'info',   
                        1: 'success',      
                        2: 'warning',   
                        3: 'light', 
                        4: 'danger',    
                        5: 'secondary',   
                        6: 'dark'       
                    } %}
                    {% for counting_campaign in counting_campaigns|reverse %}
                      <tr>
                        <td>{{ counting_campaign.id }}</td>
                        <td><a href="{{ path('app_counting_campaign_show', {'id': counting_campaign.id}) }}" title="{{ 'show'|trans }}">{{ counting_campaign.campaignName }}</a></td>
                        <td>{{ counting_campaign.startDate ? counting_campaign.startDate|date('d-m-Y') : '' }}</td>
                        <td>{{ counting_campaign.endDate ? counting_campaign.endDate|date('d-m-Y') : '' }}</td>
                        <td>
                          {# Calculer le pourcentage du temps restant #}
                            {% set totalDuration = date(counting_campaign.endDate)|date('U') - date(counting_campaign.startDate)|date('U') %}
                            {% set timeRemaining = date(counting_campaign.endDate)|date('U') - date("now")|date('U') %}
                            {% set progressPercentage = (timeRemaining / totalDuration) * 100 %}
                            {% set progressPercentage = progressPercentage < 0 ? 0 : (progressPercentage > 100 ? 100 : progressPercentage) %}
                            {% set barColor = progressPercentage > 50 ? 'bg-success' : (progressPercentage > 20 ? 'bg-warning' : 'bg-danger') %}
                            {# Afficher la barre de progression #}
                            <div class="progress mt-3">
                                <div class="progress-bar progress-bar-striped {{ barColor }} progress-bar-animated" role="progressbar" 
                                    style="width: {{ progressPercentage }}%;" 
                                    aria-valuenow="{{ progressPercentage|round }}" 
                                    aria-valuemin="0" aria-valuemax="100">
                                    {{ progressPercentage|round }}%
                                </div>
                            </div>
                        </td>
                        <td>
                          {# Utiliser le label du statut pour obtenir l'index depuis statusIndexMap #}
                          {% set campaignStatusIndex = statusIndexMap[counting_campaign.campaignStatus.id] %}
                          <div class="badge bg-{{ status_classes[campaignStatusIndex] ?? 'secondary' }}">
                              <i class="bi bi-circle-fill"></i>
                              {{ counting_campaign.campaignStatus.label }}
                          </div>
                        </td>
                        <td>
                          <div class="d-flex justify-content-end">
                            {% if is_granted('ROLE_ADMIN') %}
                              {% import 'macros/btn_actions_macros.html.twig' as macros %}
                              {{ macros.action_buttons('app_counting_campaign_new','app_counting_campaign_show', 'app_counting_campaign_edit', 'counting_campaign/_delete_form.html.twig', counting_campaign, app.request.attributes.get('_route'), true) }}
                            {% else %}
                              <a href="{{ path('app_counting_campaign_show', {'id': counting_campaign.id}) }}" class="btn btn-success btn-sm bi bi-card-text mx-2" title="{{ 'show'|trans }}"></a>
                            {% endif %}
                            {{ include('counting_campaign/_delete_form.html.twig') }}
                          </div>
                        </td>
                      </tr>
                    {% else %}
                      <tr>
                        <td colspan="7">{{ 'no_record_found'|trans }}</td>
                      </tr>
                    {% endfor %}
                    </tbody>
                </table>
                <!-- End Table with stripped rows -->
              </div>
            </div>
            <div class="card-footer d-flex justify-content-between">
              <div class="d-flex justify-content-end">
                  <a href="{{ path('app_counting_campaign_new') }}" class="btn btn-outline-info btn-sm bi bi-plus-circle-dotted mx-2"> {{ 'campaign.create_campaign'|trans }}</a>
                  <a href="{{ path('app_agents_group_index') }}" class="btn btn-outline-info btn-sm bi bi-list-task mx-2"> {{ 'group.view_groups'|trans }}</a>
                  <a href="{{ path('app_collected_data_index') }}" class="btn btn-outline-info btn-sm bi bi-list-task mx-2"> {{ 'collect.consult'|trans }}</a>
                  <a href="{{ path('app_environmental_conditions_index') }}" class="btn btn-outline-info btn-sm bi bi-list-task mx-1" title="{{ 'condition.list_environmental_conditions'|trans }}"> {{ 'condition.view_conditions'|trans }}</a>
                  <a href="{{ path('app_site_collection_new') }}" class="btn btn-outline-info btn-sm bi bi bi-geo-alt-fill mx-2"> {{ 'site_collection.add_collection_site'|trans }}</a>
              </div>
              <div>
                <button id="printButton" class="btn btn-sm btn-secondary bi bi-printer" title="{{ 'print'|trans }}"></button>
              </div>
            </div>

          </div>

        </div>
      </div>
    </section>
    {% import 'macros/show_export_macros.html.twig' as macros %}

    {{ macros.export_section(formExport, 'Export counting campaign Data') }}
</main><!-- End #main -->
{% endblock %}
