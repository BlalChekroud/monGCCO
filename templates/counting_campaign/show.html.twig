{% extends 'base.html.twig' %}

{% block title %}{{ 'campaign.title'|trans }}{% endblock %}

{% block body %}

<main id="main" class="main">

    <div class="pagetitle">
      <h1>{{ 'campaign.campaign_details'|trans }}</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="{{ path('home') }}"><i class="ri-home-4-line"></i> {{ 'breadcrumb_home'|trans }}</a></li>
          <li class="breadcrumb-item"><a href="{{ path('app_counting_campaign_index') }}">{{ 'campaign.manage'|trans }}</a></li>
          <li class="breadcrumb-item active">{{ 'show'|trans }}</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
        <div class="row">
            <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">

                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">{{ 'show'|trans }}</h5>
                        <div class="text-end my-4">
                            {% set currentDate = "now"|date('Y-m-d H:i:s') %}
                            {% if counting_campaign.startDate|date('Y-m-d H:i:s') > currentDate %}
                                <i class="text-warning bi bi-exclamation-triangle"></i><code> {{ 'campaign.cannot_start_collecting_before'|trans }} : {{ counting_campaign.startDate ? counting_campaign.startDate|date('d-m-Y H:i:s') : '' }} <i class="text-warning bi bi-exclamation-triangle"></i></code>
                            {% else %}
                                {# Calculer le pourcentage du temps restant #}
                                {% set totalDuration = date(counting_campaign.endDate)|date('U') - date(counting_campaign.startDate)|date('U') %}
                                {% set timeRemaining = date(counting_campaign.endDate)|date('U') - date("now")|date('U') %}
                                {% set progressPercentage = (timeRemaining / totalDuration) * 100 %}
                                {% set progressPercentage = progressPercentage < 0 ? 0 : (progressPercentage > 100 ? 100 : progressPercentage) %}
                                {% set barColor = progressPercentage > 50 ? 'bg-success' : (progressPercentage > 20 ? 'bg-warning' : 'bg-danger') %}
                                {# Afficher la barre de progression #}
                                {# <div class="progress-bar {{ barColor }}" style="width: {{ progressPercentage }}%;"> #}
                                <div class="progress mt-3">
                                    <div class="progress-bar progress-bar-striped {{ barColor }} progress-bar-animated" role="progressbar" 
                                        style="width: {{ progressPercentage }}%;" 
                                        aria-valuenow="{{ progressPercentage|round }}" 
                                        aria-valuemin="0" aria-valuemax="100">
                                        {{ 'remaining_time'|trans }} {{ progressPercentage|round }}%
                                    </div>
                                </div>
                            {% endif %}
                        </div>


                        <table class="table">
                            <tbody>
                                <tr>
                                    <th>{{ 'campaign.campaign_name'|trans }}</th>
                                    <td>{{ counting_campaign.campaignName }}</td>
                                </tr>
                                <tr>
                                    <th>{{'campaign.status'|trans }}</th>
                                    <td>
                                        {% set status_classes = {
                                            0: 'info',   
                                            1: 'success',      
                                            2: 'warning',   
                                            3: 'light', 
                                            4: 'danger',    
                                            5: 'secondary',   
                                            6: 'dark'     
                                        } %}
                                        {# Utiliser l'index du statut pour récupérer la classe CSS correspondante #}
                                        {% set campaignStatusIndex = statusIndexMap[counting_campaign.campaignStatus.id] %}
                                        <div class="badge bg-{{ status_classes[campaignStatusIndex] ?? 'secondary' }}">
                                            <i class="bi bi-circle-fill"></i>
                                            {{ counting_campaign.campaignStatus.label }}
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <th>{{ 'campaign.start_date'|trans }}</th>
                                    <td>{{ counting_campaign.startDate ? counting_campaign.startDate|date('d-m-Y H:i:s') : '' }}</td>
                                </tr>
                                <tr>
                                    <th>{{ 'campaign.end_date'|trans }}</th>
                                    <td>{{ counting_campaign.endDate ? counting_campaign.endDate|date('d-m-Y H:i:s') : '' }}</td>
                                </tr>
                                <tr>
                                    <th>{{ 'created_at'|trans }}</th>
                                    <td>{{ counting_campaign.createdAt ? counting_campaign.createdAt|date('d-m-Y H:i:s') : '' }}</td>
                                </tr>
                                <tr>
                                    <th>{{ 'Last_updated_at'|trans }}</th>
                                    <td>{{ counting_campaign.updatedAt ? counting_campaign.updatedAt|date('d-m-Y H:i:s') : '' }}</td>
                                </tr>
                                <tr>
                                    <th>{{ 'created_by'|trans}}</th>
                                    <td>{{ counting_campaign.createdBy.name }} {{ counting_campaign.createdBy.lastName }}</td>
                                </tr>
                                <tr>
                                    <th>{{ 'description'|trans }}</th>
                                    <td>{{ counting_campaign.description }}</td>
                                </tr>
                                <tr>
                                    <th>{{ 'campaign.sites_and_groups'|trans }}</th>
                                    <td>
                                        {# {% if counting_campaign.siteAgentsGroups|length > 0 %} #}
                                        {% if siteCollectionsByCampaign %}
                                            <div class="accordion" id="accordionGroups">
                                                {% for siteAgentsGroup in counting_campaign.siteAgentsGroups %}
                                                    {% set site = siteAgentsGroup.siteCollection %}

                                                    <div class="accordion-item">
                                                        <h2 class="accordion-header" id="heading-{{ loop.index }}">
                                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-{{ loop.index }}" aria-expanded="false" aria-controls="collapse-{{ loop.index }}">
                                                                {{ site.siteName }} ({{ site.city.name }} / {{ site.city.region.name }})
                                                            </button>
                                                        </h2>
                                                        <div id="collapse-{{ loop.index }}" class="accordion-collapse collapse" aria-labelledby="heading-{{ loop.index }}" data-bs-parent="#accordionGroups">
                                                            <div class="accordion-body">
                                                                <div class="col text-end">
                                                                    {% set currentDate = "now"|date('Y-m-d H:i:s') %}

                                                                    {% set userInGroup = false %}

                                                                    {% if siteAgentsGroup.agentsGroup|length > 0 %}
                                                                        {% for group in siteAgentsGroup.agentsGroup %}
                                                                            {% for agent in group.groupMember %}
                                                                                {% if app.user == agent %}
                                                                                    {% set userInGroup = true %}
                                                                                {% endif %}
                                                                            {% endfor %}
                                                                            
                                                                        {% endfor %}

                                                                        {% if userInGroup or is_granted('ROLE_SUPER_ADMIN') %}
                                                                            {% if counting_campaign.startDate|date('Y-m-d H:i:s') <= currentDate %}
                                                                                {% if counting_campaign.campaignStatus != statusClosed and counting_campaign.campaignStatus != statusSuspended %}
                                                                                    
                                                                                    {# Vérifiez si le site a des conditions environnementales associées #}
                                                                                    {% if existingConditions[site.id] is defined %}
                                                                                        {# La condition environnementale existe pour ce site #}
                                                                                        {% set condition = existingConditions[site.id] %}
                                                                                        
                                                                                        {# Vérifiez si `collectedData` est défini et vide pour la condition #}
                                                                                        {# {% if condition and not condition.collectedData  %} #}
                                                                                        {% if condition is defined and condition and not condition.collectedData %}
                                                                                            <a href="{{ path('app_collected_data_new', {'campaignId': counting_campaign.id, 'siteId': site.id}) }}" class="btn btn-success btn-sm" title="{{ 'campaign.start_collecting'|trans }}"> {{ 'campaign.collect_data'|trans }}
                                                                                                <i class="bi bi-arrow-bar-right">
                                                                                                    <div class="spinner-grow spinner-grow-sm text-light" role="status"></div>
                                                                                                </i>
                                                                                            </a>
                                                                                        {% else %}
                                                                                            <a href="{{ path('app_environmental_conditions_new', {'siteId': site.id, 'campaignId': counting_campaign.id}) }}" class="btn btn-outline-success btn-sm my-2" title="{{ 'campaign.add_conditions_then_start_collecting'|trans }}">
                                                                                                {{ 'campaign.add_environmental_conditions'|trans }}
                                                                                            </a>
                                                                                        {% endif %}
                                                                                    {% else %}
                                                                                        {# Aucune condition environnementale n'existe encore pour ce site #}
                                                                                        <a href="{{ path('app_environmental_conditions_new', {'siteId': site.id, 'campaignId': counting_campaign.id}) }}" class="btn btn-outline-success btn-sm my-2" title="Ajouter les conditions environnementales puis commencer à collecter">
                                                                                            {{ 'campaign.add_environmental_conditions'|trans }}
                                                                                        </a>
                                                                                    {% endif %}
                                                                                {% endif %}
                                                                            {% else %}
                                                                                <code>
                                                                                    <i class="text-warning bi bi-exclamation-triangle"></i> 
                                                                                    {{ 'campaign.cannot_start_collecting_before'|trans }} : 
                                                                                    {{ counting_campaign.startDate ? counting_campaign.startDate|date('d-m-Y H:i:s') : '' }}
                                                                                    <i class="text-warning bi bi-exclamation-triangle"></i>
                                                                                </code>
                                                                            {% endif %}
                                                                        {% else %}
                                                                            <i class="text-warning bi bi-exclamation-triangle me-1"> {{ 'campaign.reserved_for_site_agents'|trans }}</i>
                                                                        {% endif %}
                                                                    {% endif %}

                                                                </div>
                                                                <h6>{{ 'campaign.associated_agent_groups'|trans }} :</h6>
                                                                {% if siteAgentsGroup.agentsGroup|length > 0 %}
                                                                    {% for group in siteAgentsGroup.agentsGroup %}
                                                                        <ul>
                                                                            <li>
                                                                                <h6>{{ group.groupName }} ({{ 'campaign.leader'|trans }} : {{ group.leader.name }} {{ group.leader.lastName }})</h6>
                                                                                <ul>
                                                                                    {% for agent in group.groupMember %}
                                                                                        <li>{{ agent.name }} {{ agent.lastName }}</li>
                                                                                    {% endfor %}
                                                                                </ul>
                                                                            </li>
                                                                        </ul>
                                                                    {% endfor %}
                                                                {% else %}
                                                                    <span>{{ 'campaign.no_group_found'|trans }}</span>
                                                                {% endif %}
                                                            </div>
                                                        </div>
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        {% else %}
                                            <span>{{ 'campaign.no_site_found'|trans }}</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    
                    <div class="card-footer d-flex justify-content-between">
                        <div>
                            <a href="{{ path('app_counting_campaign_index') }}" class="btn btn-sm btn-outline-secondary mx-1" title="{{ 'campaign.back_to_campaign_consultation'|trans }}">{{ 'back'|trans }}</a>
                            
                            {% if is_granted("ROLE_ADMIN") %}
                                {% if counting_campaign.campaignStatus != statusSuspended and counting_campaign.campaignStatus != statusClosed and counting_campaign.campaignStatus != statusCancelled %}
                                    <a href="{{ path('app_counting_campaign_suspend', {'id': counting_campaign.id}) }}" class="btn btn-sm btn-secondary bi bi-pause-fill" onclick="return confirm('{{ 'campaign.confirm_suspend'|trans }}');"> {{ 'campaign.suspend'|trans }}</a>
                                {% elseif counting_campaign.campaignStatus == statusSuspended %}
                                    <a href="{{ path('app_counting_campaign_suspend', {'id': counting_campaign.id}) }}" class="btn btn-sm btn-warning bi bi-play-fill" onclick="return confirm('{{ 'campaign.confirm_resume'|trans }}');" title="{{ 'campaign.end_campaign_suspension'|trans }}">{{ 'campaign.resume'|trans }}</a>
                                {% endif %}
                                {% if counting_campaign.campaignStatus == statusFinished %}
                                    <a href="{{ path('app_counting_campaign_close', {'id': counting_campaign.id}) }}" class="btn btn-sm btn-success bi bi-lock-fill" onclick="return confirm('{{ 'campaign.confirm_close'|trans }}');"> {{ 'campaign.close_campaign'|trans }}</a>
                                {% endif %}
                                {% if counting_campaign.campaignStatus != statusClosed and counting_campaign.campaignStatus != statusCancelled %}
                                    <a href="{{ path('app_counting_campaign_cancel', {'id': counting_campaign.id}) }}" class="btn btn-sm btn-dark bi bi-x-lg" onclick="return confirm('{{ 'campaign.confirm_cancel'|trans }}');"> {{ 'campaign.cancel_campaign'|trans }}</a>
                                {% endif %}
                            {% endif %}
                        </div>
                        <div class="d-flex justify-content-end">
                            {% if is_granted('ROLE_ADMIN') %}
                                {% import 'macros/btn_actions_macros.html.twig' as macros %}
                                {{ macros.action_buttons('app_counting_campaign_new','app_counting_campaign_show', 'app_counting_campaign_edit', 'counting_campaign/_delete_form.html.twig', counting_campaign, app.request.attributes.get('_route'), true) }}
                            {% else %}
                                <button onclick="printDiv()" class="btn btn-sm btn-outline-secondary bi bi-printer" title="{{ 'print'|trans }}"></button>
                            {% endif %}
                            {{ include('counting_campaign/_delete_form.html.twig') }}
                        </div>
                    </div>
                    
                </div>
            </div>
        </div>
    </section>

    <section>
        <div class="row">
            <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
              <div id="printableArea">
                <div class="card">
                    <div class="card-body">
                        <!-- Accordion without outline borders -->
                        <div class="accordion accordion-flush" id="accordionFlushExample">
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="flush-headingOne">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseOne" aria-expanded="false" aria-controls="flush-collapseOne">
                                        <h6 class="mt-4"><i class="bi bi-info-circle-fill text-info"></i> {{ 'campaign.campaign_details'|trans }}</h6>
                                    </button>
                                </h2>
                                <div id="flush-collapseOne" class="accordion-collapse collapse" aria-labelledby="flush-headingOne" data-bs-parent="#accordionFlushExample">
                                    <div class="accordion-body">
                                        {{ include('counting_campaign/detail.html.twig') }}
                                    </div>
                                </div>

                            </div>
                        </div><!-- End Accordion without outline borders -->
                    </div>

                </div>
            
              </div>
            </div>
        </div>

    </section>
    
    {% import 'macros/show_export_macros.html.twig' as macros %}

    {{ macros.export_section(formExport, 'Export counting campaign Data') }}
</main>
{% endblock %}
