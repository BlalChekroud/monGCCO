{% if is_granted('ROLE_ADMIN') %}
    <form method="post" action="{{ path('app_site_agents_group_delete', {'id': site_agents_group.id}) }}" onsubmit="return confirm('{{ 'delete_confirm'|trans }}');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ site_agents_group.id) }}">
        <button class="btn">Delete</button>
    </form>
{% endif %}