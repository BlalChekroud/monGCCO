{% if is_granted('ROLE_COLLECTOR') %}
    <form method="post" action="{{ path('app_environmental_conditions_delete', {'id': environmental_condition.id}) }}" onsubmit="return confirm('{{ 'delete_confirm'|trans }}');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ environmental_condition.id) }}">
        <button class="btn btn-danger btn-sm bi bi-trash mx-2" title="Supprimer"></button>
    </form>
{% endif %}