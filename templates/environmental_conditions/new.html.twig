{% extends 'base.html.twig' %}

{% block title %}{{'condition.title'|trans }}{% endblock %}

{% block body %}
    <main id="main" class="main">

        <div class="pagetitle">
        <h1>{{ 'condition.title_add'|trans }}</h1>
        <nav>
            <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('home') }}"><i class="ri-home-4-line"></i> {{ 'breadcrumb_home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_environmental_conditions_index') }}">{{ 'condition.manage'|trans }}</a></li>
            <li class="breadcrumb-item active">{{ 'add'|trans }}</li>
            </ol>
        </nav>
        </div><!-- End Page Title -->

        <section class="section">
            <div class="row">
                <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">

                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title d-flex justify-content-start align-items-center">
                                {{ 'condition.informations'|trans }} &nbsp;
                                <div class="fw-bold text-primary"> {{ siteCollection.siteName }}</div>
                            </h5>

                            {{ include('environmental_conditions/_form.html.twig') }}

                        </div>
                        <div class="card-footer">
                            <a href="{{ path('app_environmental_conditions_index') }}" class="btn btn-sm btn-outline-secondary" title="{{ 'condition.return'|trans }}">{{ 'back'|trans }}</a>
                        </div>
                    </div>

                </div>

            </div>
        </section>
    </main>
{% endblock %}
