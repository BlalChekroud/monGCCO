{% extends 'base.html.twig' %}

{% block title %}{{'condition.title'|trans }}{% endblock %}

{% block body %}
  <main id="main" class="main">

    <div class="pagetitle">
      <h1>{{'condition.title'|trans }}</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="{{ path('home') }}"><i class="ri-home-4-line"></i> {{ 'breadcrumb_home'|trans }}</a></li>
          <li class="breadcrumb-item active">{{ 'condition.manage'|trans }}</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
      <div class="row">
        <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
          <div class="card">
            <div class="card-body">
              <h5 class="card-title">{{ 'card_title'|trans }}</h5>
             <div id="printableArea">
                <!-- Table with stripped rows -->
                <table class="table datatable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>{{'site_collection.siteName'|trans }}</th>
                            <th>{{'collect.collection_number'|trans }}</th>
                            <th>{{'created_by'|trans }}</th>
                            <th>{{ 'created_at'|trans }}</th>
                            <th>{{ 'Last_updated_at'|trans }}</th>
                            <th>{{ 'actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for environmental_condition in environmental_conditions|reverse %}
                        <tr>
                            <td>{{ environmental_condition.id }}</td>
                            <td>{{ environmental_condition.siteCollection.siteName ?? '' }}</td>
                            <td>
                              {% if environmental_condition.collectedData is not empty %}
                                {{ environmental_condition.collectedData.id ?? ''}}
                              {% else %}
                                <p class="explanation">{{'collect.no_collection'|trans }}</p>
                              {% endif %}
                            </td>
                            <td>{{ environmental_condition.user.name }} {{ environmental_condition.user.lastName }}</td>
                            <td>{{ environmental_condition.createdAt ? environmental_condition.createdAt|date('d-m-Y H:i:s') : '' }}</td>
                            <td>{{ environmental_condition.updatedAt ? environmental_condition.updatedAt|date('d-m-Y H:i:s') : '' }}</td>
                            <td>
                                <div class="d-flex justify-content-end">
                                    {% import 'macros/btn_actions_macros.html.twig' as macros %}
                                    {{ macros.action_buttons('app_environmental_conditions_new','app_environmental_conditions_show', 'app_environmental_conditions_edit', 'environmental_condition/_delete_form.html.twig', environmental_condition, app.request.attributes.get('_route')) }}
                                    {{ include('environmental_conditions/_delete_form.html.twig') }}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5">{{ 'no_record_found'|trans }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
              <!-- End Table with stripped rows -->    
             </div>          
              
            </div>
            <div class="card-footer">
              <div>
                <a href="{{ path('app_counting_campaign_index') }}" class="btn btn-outline-info btn-sm bi bi-list-task"> {{'campaign.consult'|trans }}</a>
                <a href="{{ path('app_collected_data_index') }}" class="btn btn-outline-info btn-sm bi bi-list-task mx-1"> {{'collect.consult'|trans }}</a>
                {# <a href="{{ path('app_collected_data_new') }}" class="btn btn-outline-info btn-sm bi bi-plus-circle-dotted mx-1"> Créer une collecte</a> #}
              </div>
              <div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

  </main><!-- End #main -->
{% endblock %}
