<!-- Présentation de la campagne -->
<div class="mb-3 d-flex align-items-center justify-content-center">
    <label class="fw-bold text-secondary me-2">{{ 'campaign.name'|trans }} :</label>
    <a href="{{ path('app_counting_campaign_show', {'id': countingCampaign.id}) }}"
        class="fw-bold btn btn-outline-success btn-sm"
        title="{{ 'campaign.campaign_details'|trans }}"
        aria-label="{{ 'campaign.campaign_details'|trans }}">
        <i class="bi bi-eye"></i> {{ countingCampaign.campaignName }}
    </a>
</div>

{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}

    <fieldset class="border p-3 rounded">
        {% for field, label in {
            'disturbed': 'conditionDisturbed',
            'weather': 'conditionWeather',
            'tidal': 'conditionTidal',
            'water': 'conditionWater',
            'ice': 'conditionIce'
        } %}
            <div class="row mb-2 align-items-center">
                <div class="col-md-5">
                    {{ form_label(attribute(form, field), (label ~ '.description')|trans ~ '<span class="requiredField">*</span>'|raw, {'class': 'fw-semibold mb-1'}) }}
                    {% if field == 'disturbed' or field == 'weather' %}
                        <p class="explanation mt-0 mb-0 text-muted">{{ (label ~ '.explanation')|trans }}</p>
                    {% endif %}
                </div>
                <div class="col-md-5">
                    {{ form_widget(attribute(form, field), {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(attribute(form, field)) }}
                </div>
                <div class="col-md-2 text-end">
                    <a href="{{ path('app_' ~ field ~ '_new') }}" class="btn btn-outline-info btn-sm explanation" title="{{('add_a_' ~ field)|trans }}">
                        <i class="bi bi-plus-circle-dotted"></i> {{ 'add'|trans }}
                    </a>
                </div>
            </div>
        {% endfor %}

        {% import 'macros/btn_actions_macros.html.twig' as macros %}
        <div class="mt-3">
            {{ macros.action_buttons('app_environmental_conditions_new','app_environmental_conditions_show', 'app_environmental_conditions_edit', 'environmental_condition/_delete_form.html.twig', environmental_condition, app.request.attributes.get('_route')) }}
        </div>

    </fieldset>

{{ form_end(form) }}
