{% extends 'base.html.twig' %}

{% block title %}{{'condition.title'|trans }}{% endblock %}

{% block body %}
  <main id="main" class="main">

    <div class="pagetitle">
      <h1>{{ 'condition.title_edit'|trans }}</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="{{ path('home') }}"><i class="ri-home-4-line"></i> {{ 'breadcrumb_home'|trans }}</a></li>
          <li class="breadcrumb-item"><a href="{{ path('app_environmental_conditions_index') }}">{{ 'condition.manage'|trans }}</a></li>
          <li class="breadcrumb-item active">{{ 'modification'|trans }}</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
      <div class="row">
        <div class="col-sm-10 col-md-10 col-lg-10 col-xl-10">

          <div class="card">
            <div class="card-body">
              <h5 class="card-title">{{ 'condition.the_new_informations'|trans }}</h5>

              {{ include('environmental_conditions/_form.html.twig') }}

            </div>
            <div class="card-footer d-flex justify-content-between">
              <div>
                <a href="{{ path('app_environmental_conditions_index') }}" class="btn btn-sm btn-outline-secondary" title="{{ 'condition.return'|trans }}">{{ 'back'|trans }}</a>
                <a href="{{ path('app_counting_campaign_index') }}" class="btn btn-outline-info btn-sm bi bi-list-task mx-1"> {{'campaign.consult'|trans }}</a>
              </div>
              <div class="d-flex justify-content-end">
                {% import 'macros/btn_actions_macros.html.twig' as macros %}
                {{ macros.action_buttons('app_environmental_conditions_new','app_environmental_conditions_show', 'app_environmental_conditions_edit', 'environmental_condition/_delete_form.html.twig', environmental_condition, app.request.attributes.get('_route'), false) }}
                {{ include('environmental_conditions/_delete_form.html.twig') }}
              </div>
            </div>
          </div>

        </div>

      </div>
    </section>

  </main><!-- End #main -->
{% endblock %}
