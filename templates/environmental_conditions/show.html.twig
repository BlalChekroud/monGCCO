{% extends 'base.html.twig' %}

{% block title %}{{'condition.title'|trans }}{% endblock %}

{% block body %}
<main id="main" class="main">

    <div class="pagetitle">
      <h1>{{'condition.title_show'|trans }}</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="{{ path('home') }}"><i class="ri-home-4-line"></i> {{ 'breadcrumb_home'|trans }}</a></li>
          <li class="breadcrumb-item"><a href="{{ path('app_environmental_conditions_index') }}">{{ 'condition.manage'|trans }}</a></li>
          <li class="breadcrumb-item active">{{'show'|trans }}</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
        <div class="row">
            <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">

                <div class="card">
                    <div class="card-body">
                      <div id="printableArea">
                        <h5 class="card-title">{{'show'|trans }}</h5>

                        <table class="table">
                            <tbody>
                                <tr>
                                    <th>{{'campaign.name'|trans }}</th>
                                    <td>{{ environmental_condition.countingCampaign.campaignName ?? '' }}</td>
                                </tr>
                                <tr>
                                    <th>{{'site_collection.siteName'|trans }}</th>
                                    <td>{{ environmental_condition.siteCollection.siteName ?? '' }}</td>
                                </tr>
                                <tr>
                                    <th>{{'created_by'|trans }}</th>
                                    <td>{{ environmental_condition.user.name ?? '' }} {{ environmental_condition.user.lastName ?? '' }}</td>
                                </tr>
                                <tr>
                                    <th>{{'condition.collection_associated'|trans }}<h6 class="explanation">{{'condition.collection_date'|trans }}</h6></th>
                                    {% if environmental_condition.collectedData is not empty %}
                                        <td>
                                            {{ environmental_condition.collectedData.id }}
                                            <p class="explanation">{{ environmental_condition.collectedData.createdAt ? environmental_condition.createdAt|date('d-m-Y') : '' }}</p>
                                        </td>
                                    {% else %}
                                        <td>{{'condition.no_collection_associated'|trans }}</td>
                                    {% endif %}
                                    </td>
                                </tr>
                                <tr>
                                    <th>
                                        {{ 'conditionDisturbed.description'|trans }}
                                        <h6 class="explanation">{{ 'conditionDisturbed.explanation'|trans }}</h6>
                                    </th>
                                    <td>{{ environmental_condition.disturbed.label ?? '' }}</td>
                                </tr>
                                <tr>
                                    <th>
                                        {{ 'conditionWeather.description'|trans }}
                                        <h6 class="explanation">{{ 'conditionWeather.explanation'|trans }}</h6>
                                    </th>
                                    <td>{{ environmental_condition.weather.label ?? '' }}</td>
                                </tr>
                                <tr>
                                    <th>{{ 'conditionTidal.description'|trans }}</th>
                                    <td>{{ environmental_condition.tidal.label ?? '' }}</td>
                                </tr>
                                <tr>
                                    <th>{{ 'conditionWater.description'|trans }}</th>
                                    <td>{{ environmental_condition.water.label ?? '' }}</td>
                                </tr>
                                <tr>
                                    <th>{{ 'conditionIce.description'|trans }}</th>
                                    <td>{{ environmental_condition.ice.label ?? '' }}</td>
                                </tr>
                                <tr>
                                    <th>{{ 'created_at'|trans }}</th>
                                    <td>{{ environmental_condition.createdAt ? environmental_condition.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                                </tr>
                                <tr>
                                    <th>{{ 'Last_updated_at'|trans }}</th>
                                    <td>{{ environmental_condition.updatedAt ? environmental_condition.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                                </tr>
                            </tbody>
                        </table>
                      </div>
                    </div>
                    <div class="card-footer">
                        <div class="d-flex justify-content-between">
                            <div>
                                <a href="{{ path('app_environmental_conditions_index') }}" class="btn btn-sm btn-outline-secondary" title="{{ 'condition.return'|trans }}">{{ 'back'|trans }}</a>
                                {% if environmental_condition.countingCampaign %}
                                    <a href="{{ path('app_counting_campaign_show', {'id': environmental_condition.countingCampaign.id}) }}" class="btn btn-outline-success btn-sm bi bi-eye mx-1" title="{{ 'campaign.campaign_details'|trans }}"> {{'campaign.name'|trans }}</a>
                                {% endif %}
                                <a href="{{ path('app_environmental_conditions_new') }}" class="btn btn-outline-info btn-sm bi bi bi-geo-alt-fill mx-2"> {{ 'site_collection.add_collection_site'|trans }}</a>
                            </div>
                            <div class="d-flex justify-content-end">
                                {% import 'macros/btn_actions_macros.html.twig' as macros %}
                                {{ macros.action_buttons('app_environmental_conditions_new','app_environmental_conditions_show', 'app_environmental_conditions_edit', 'environmental_condition/_delete_form.html.twig', environmental_condition, app.request.attributes.get('_route')) }}
                                {{ include('environmental_conditions/_delete_form.html.twig') }}
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </section>
</main>
{% endblock %}
