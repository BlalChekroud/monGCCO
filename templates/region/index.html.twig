{% extends 'base.html.twig' %}

{% block title %}{{'region.title'|trans }}{% endblock %}

{% block body %}
  <main id="main" class="main">

    <div class="pagetitle">
      <h1>{{'region.title'|trans }}</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="{{ path('home') }}"><i class="ri-home-4-line"></i> {{ 'breadcrumb_home'|trans }}</a></li>
          <li class="breadcrumb-item active">{{ 'region.manage'|trans }}</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
      <div class="row">
        <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
          <div class="card">
            <div class="card-body">
                <h5 class="card-title">{{ 'card_title'|trans }}</h5>
                <div id="printableArea">
                    <table class="table datatable">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>{{ 'region.name'|trans }}</th>
                                <th>{{'region.code'|trans }}</th>
                                <th>{{'country.name'|trans }}</th>
                                <th>{{ 'created_at'|trans }}</th>
                                <th>{{ 'actions'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for region in regions %}
                            <tr>
                                <td>{{ region.id }}</td>
                                <td>{{ region.name }}</td>
                                <td>{{ region.regionCode }}</td>
                                <td>
                                {{ region.country.name }}</td>
                                <td>{{ region.createdAt ? region.createdAt|date('d-m-Y') : '' }}</td>
                                <td>
                                    <div class="d-flex justify-content-end">
                                        {% import 'macros/btn_actions_macros.html.twig' as macros %}
                                        {{ macros.action_buttons('app_region_new','app_region_show', 'app_region_edit', 'region/_delete_form.html.twig', region, app.request.attributes.get('_route'), true) }}
                                        {{ include('region/_delete_form.html.twig') }}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6">{{ 'no_record_found'|trans }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>  
                </div>          
              
            </div>
            <div class="card-footer d-flex justify-content-between">
              <a href="{{ path('app_region_new') }}" class="btn btn-outline-info btn-sm bi bi-plus-circle-dotted"> {{'add_a_region'|trans }}</a>
              <a href="{{ path('app_country_index') }}" class="btn btn-outline-info btn-sm bi bi-list-task mx-1"> {{'country.consult'|trans }}</a>
              <a href="{{ path('app_city_index') }}" class="btn btn-outline-info btn-sm bi bi-list-task mx-1"> {{'city.consult'|trans }}</a>
            </div>
          </div>

        </div>
      </div>
    </section>

    {% import 'macros/form_macros.html.twig' as form_macros %}
    {{ form_macros.csv_import_form(form, 'app_region_index', formExport, 'Import regions Data', 'Export regions Data') }}


    {% if headers is defined and rows is defined %}
        {{ form_macros.csv_modal(headers, rows, csvData, 'app_region_index', ['region', 'regionCode'], ['country', 'iso2']) }}
    {% endif %}

  </main><!-- End #main -->
{% endblock %}
