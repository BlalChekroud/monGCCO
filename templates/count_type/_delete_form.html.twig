{% if is_granted('ROLE_DELETE') %}
    <form method="post" action="{{ path('app_count_type_delete', {'id': count_type.id}) }}" onsubmit="return confirm('{{ 'delete_confirm'|trans }}');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ count_type.id) }}">
        <button class="btn btn-danger btn-sm bi bi-trash-fill mx-2" title="{{ 'countType.delete'|trans }}"></button>
    </form>
{% endif %}
