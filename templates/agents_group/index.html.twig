{% extends 'base.html.twig' %}

{% block title %}{{ 'agentsGroup.title'|trans }}{% endblock %}

{% block body %}
  <main id="main" class="main">

    <div class="pagetitle">
      <h1>{{ 'agentsGroup.title'|trans }}</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="{{ path('home') }}"><i class="ri-home-4-line"></i> {{ 'breadcrumb_home'|trans }}</a></li>
          <li class="breadcrumb-item active">{{ 'agentsGroup.breadcrumb_management'|trans }}</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
      <div class="row">
        <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
          <div class="card">
            <div class="card-body">
              <h5 class="card-title">{{ 'card_title'|trans }}</h5>
              <div id="printableArea">
                <!-- Table with stripped rows -->
                <table class="table datatable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>{{ 'group_name'|trans }}</th>
                            <th>{{ 'group_members'|trans }}</th>
                            <th>{{ 'group_leader'|trans }}</th>
                            <th>{{ 'created_at'|trans }}</th>
                            <th>{{ 'actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for agents_group in agents_groups|reverse %}
                        <tr>
                            <td>{{ agents_group.id }}</td>
                            <td>{{ agents_group.groupName }}</td>
                            <td>
                                <ol>
                                    {% set sorted_group = agents_group.groupMember|sort((a, b) => a.name <=> b.name) %}
                                        {% for member in sorted_group %}
                                            <li>
                                                {{ member.name }} {{ member.lastName }}
                                            </li>
                                        {% else %}
                                            <p colspan="7">{{ 'no_record_found'|trans }}</p>
                                    {% endfor %}
                                </ol>
                            </td>
                            <td>{{ agents_group.leader.name }} {{ agents_group.leader.lastName }}</td>
                            <td>{{ agents_group.createdAt ? agents_group.createdAt|date('d-m-Y') : '' }}</td>
                            <td>
                                <div class="d-flex justify-content-end">
                                    {% import 'macros/btn_actions_macros.html.twig' as macros %}
                                    {{ macros.action_buttons('app_agents_group_new','app_agents_group_show', 'app_agents_group_edit', 'agents_group/_delete_form.html.twig', agents_group, app.request.attributes.get('_route')) }}
                                    {{ include('agents_group/_delete_form.html.twig') }}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6">{{ 'no_record_found'|trans }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
                <!-- End Table with stripped rows -->    
              </div>          
            </div>
            <div class="card-footer">
              <a href="{{ path('app_agents_group_new') }}" class="btn btn-outline-info btn-sm bi bi-plus-circle-dotted"> {{ 'create_group'|trans }}</a>
              <a href="{{ path('app_nature_reserve_index') }}" class="btn btn-outline-info btn-sm bi bi-list-task mx-1"> {{ 'consult_reserves'|trans }}</a>
              <a href="{{ path('app_counting_campaign_index') }}" class="btn btn-outline-info btn-sm bi bi-list-task mx-1"> {{ 'campaign.consult'|trans }}</a>
            </div>
          </div>

        </div>
      </div>
    </section>

  </main><!-- End #main -->
{% endblock %}
