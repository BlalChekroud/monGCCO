{% if is_granted('ROLE_ADMIN') %}
    <form method="post" action="{{ path('app_agents_group_delete', {'id': agents_group.id}) }}" onsubmit="return confirm('{{ 'delete_confirm'|trans }}');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ agents_group.id) }}">
        <button class="btn btn-danger btn-sm bi bi-trash-fill mx-2" title="{{ 'agentsGroup.delete_group'|trans }}"></button>
    </form>
{% endif %}