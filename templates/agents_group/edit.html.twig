{% extends 'base.html.twig' %}

{% block title %}{{ 'agentsGroup.title'|trans }}{% endblock %}

{% block body %}
  <main id="main" class="main">

    <div class="pagetitle">
      <h1>{{ 'agentsGroup.edit_this_group'|trans }}</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="{{ path('home') }}"><i class="ri-home-4-line"></i> {{ 'breadcrumb_home'|trans }}</a></li>
          <li class="breadcrumb-item"><a href="{{ path('app_agents_group_index') }}">{{ 'agentsGroup.breadcrumb_management'|trans }}</a></li>
          <li class="breadcrumb-item active">{{ 'modification'|trans }}</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
      <div class="row">
        <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">

          <div class="card">
            <div class="card-body">
              <h5 class="card-title">{{ 'agentsGroup.the_new_informations'|trans }}</h5>

              {{ include('agents_group/_form.html.twig') }}

            </div>
            <div class="card-footer d-flex justify-content-between">
              <div>
                <a href="{{ path('app_agents_group_index') }}" class="btn btn-sm btn-outline-secondary mx-1" title="{{ 'agentsGroup.return_to_agent_groups_consultation'|trans }}">{{ 'back'|trans }}</a>
              </div>
              <div class="d-flex justify-content-end">
                {% import 'macros/btn_actions_macros.html.twig' as macros %}
                {{ macros.action_buttons('app_agents_group_new', 'app_agents_group_show', 'app_agents_group_edit', 'agents_group/_delete_form.html.twig', agents_group, app.request.attributes.get('_route'), false) }}
                {{ include('agents_group/_delete_form.html.twig') }}
              </div>
            </div>
          </div>

        </div>

      </div>
    </section>

  </main><!-- End #main -->
{% endblock %}
