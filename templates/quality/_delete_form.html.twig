{% if is_granted('ROLE_DELETE') %}
    <form method="post" action="{{ path('app_quality_delete', {'id': quality.id}) }}" onsubmit="return confirm('{{ 'delete_confirm'|trans }}');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ quality.id) }}">
        <button class="btn btn-danger btn-sm bi bi-trash-fill mx-2" title="{{ 'collectQuality.delete'|trans }}"></button>
    </form>
{% endif %}