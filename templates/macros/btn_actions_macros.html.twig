{% macro action_buttons(creat_path, show_path, edit_path, delete_form, entit, current_route, is_first_call = true) %}
    {% if current_route == creat_path %}
        <div class="row mb-3">
            <div class="col-sm-3 col-md-3 col-lg-3 col-xl-3">
                <button type="reset" class="btn-sm btn btn-outline-dark bi bi-x-square"> {{ 'cancel'|trans }}</button>
            </div>
            <div class="col-sm-3 col-md-3 col-lg-3 col-xl-3">
                <button class="btn-sm btn btn-outline-primary bi bi-save"> {{ button_label|default("save"|trans) }}</button>
            </div>
        </div>
    {% elseif current_route == edit_path %}
        {% if is_first_call %}
            <div class="row mb-3">
                <div class="col-sm-3 col-md-3 col-lg-3 col-xl-3">
                    <button type="reset" class="btn-sm btn btn-outline-dark bi bi-x-square"> {{ 'cancel'|trans }}</button>
                </div>
                <div class="col-sm-3 col-md-3 col-lg-3 col-xl-3">
                    <button class="btn-sm btn btn-outline-primary bi bi-save"> {{ button_label|default("update"|trans ) }}</button>
                </div>
            </div>
        {% else %}
            {% if current_route != show_path and show_path != 'home' %}
                <a href="{{ path(show_path, {'id': entit.id}) }}" class="btn btn-success btn-sm bi bi-card-text mx-2" title="{{ 'show'|trans }}"></a>
            {% endif %}
        {% endif %}
    {% else %}
        {% if current_route != show_path and show_path != 'home' %}
            <a href="{{ path(show_path, {'id': entit.id}) }}" class="btn btn-success btn-sm bi bi-card-text mx-2" title="{{ 'show'|trans }}"></a>
        {% endif %}
        {% if current_route != edit_path %}
            {% if current_route == show_path %}
                <button id="printButton" class="btn btn-outline-secondary btn-sm me-2 bi bi-printer" title="{{ 'print'|trans }}"></button>
                <button id="exportCSVButton" class="btn btn-outline-secondary btn-sm bi bi-folder" title="{{ 'export_as_CSV'|trans }}"></button>
            {% endif %}
            <a href="{{ path(edit_path, {'id': entit.id}) }}" class="btn btn-primary btn-sm bi bi-pencil-square mx-2" title="{{ 'edit'|trans }}"></a>
        {% endif %}
    {% endif %}
    {# <script src="{{ asset('./js/csv.js') }}"></script> #}
{% endmacro %}
