{% macro csv_import_form(form, submit_action, formExport, import_title, export_title) %}
    <section class="section py-4">
        <div class="container">
            <div class="card shadow border-0">
                <div class="card-body">
                    <div class="row align-items-center">
                        <!-- Import Section -->
                        <div class="col-lg-6">
                            <div class="p-4">
                                <h5 class="text-dark mb-3">
                                    <i class="bi bi-upload me-2 text-primary"></i>{{ import_title|trans }}
                                </h5>
                                {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'id': 'csvForm'}}) }}
                                    {{ form_row(form.csvFile, {
                                        'attr': {'onchange': 'document.getElementById("csvForm").submit();'}
                                    }) }}
                                {{ form_end(form) }}
                                <small class="form-text text-muted">{{ 'csv_import_instruction'|trans }}</small>
                            </div>
                        </div>

                        <!-- Export Section -->
                        <div class="col-lg-6 bg-light">
                            <div class="p-4 text-center">
                                <h5 class="text-dark mb-3">
                                    <i class="bi bi-download me-2 text-primary"></i>{{ export_title|trans }}
                                </h5>
                                <p class="text-muted mb-4 explanation">
                                    {{ 'Export Data Description'|trans }}
                                </p>
                                <div class="d-inline-block">
                                    {{ form(formExport, { attr: { class: 'btn-group' } }) }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endmacro %}

{% macro csv_modal(headers, rows, csvData, submit_action, requiredHeaders, optionalHeaders) %}
    <!-- Modal -->
    <div class="modal fade" id="csvPreviewModal" tabindex="-1" aria-labelledby="csvPreviewModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable"> <!-- Changement ici pour agrandir la fenêtre -->
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="csvPreviewModalLabel">{{ 'csv_preview_title'|trans }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'close'|trans }}"></button>
                </div>
                <div class="modal-body">
                    <p>
                        <b>{{ 'note'|trans }}: </b><span>{{ 'columns'|trans }}</span>
                        {% for header in requiredHeaders %}
                            <code>{{ header }}, </code>
                        {% endfor %}
                        <span>{{ 'are_mandatory'|trans }}</span>
                    </p>
                    {% if optionalHeaders|length > 0 %}
                        <p>
                            <span>{{ 'columns'|trans }} </span>
                            {% for header in optionalHeaders %}
                                <code>{{ header }}, </code>
                            {% endfor %}
                            <span>{{ 'are_optional'|trans }}</span>
                        </p>
                    {% endif %}
                    <!-- Afficher les colonnes manquantes -->
                    <span class="text-danger">{{ 'missing_columns'|trans }} :
                        {% set missingHeaders = [] %}
                        {% for requiredHeader in requiredHeaders %}
                            {% if requiredHeader not in headers %}
                                {% set missingHeaders = missingHeaders|merge([requiredHeader]) %}
                            {% endif %}
                        {% endfor %}
                        {% if missingHeaders is empty %}
                            <span>{{ 'no_missing_columns'|trans }}</span>
                        {% else %}
                            {% for missingHeader in missingHeaders %}
                                <code>{{ missingHeader }}</code>{% if not loop.last %}, {% endif %}
                            {% endfor %}
                        {% endif %}
                    </span>
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                {% for header in headers %}
                                    <th>
                                        {{ header }} 
                                        {% if header in requiredHeaders %}
                                            <span class="text-success bi bi-check-circle me-1"></span> <!-- Indique que c'est obligatoire -->
                                        {% endif %}
                                        {% if header in optionalHeaders %}
                                            <span class="text-success bi bi-check-circle me-1"></span> <!-- Indique que c'est obligatoire -->
                                        {% endif %}
                                    </th>
                                {% endfor %}
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in rows %}
                                <tr>
                                    {% for cell in row %}
                                        <td>{{ cell }}</td>
                                    {% endfor %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <form method="post" action="{{ path(submit_action) }}">
                        <input type="hidden" name="csvData" value="{{ csvData|e('html_attr') }}">
                        {% if missingHeaders is empty %}
                            <button type="submit" name="action" value="import" class="btn btn-outline-primary btn-sm bi bi-upload"> {{ 'import'|trans }}</button>
                        {% endif %}
                        <button type="button" class="btn btn-outline-dark btn-sm bi bi-x-square" data-bs-dismiss="modal"> {{ 'cancel'|trans }}</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    {# <script src="{{ asset('./js/csv.js') }}"></script> #}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var myModal = new bootstrap.Modal(document.getElementById('csvPreviewModal'), {});
            myModal.show();
        });
    </script>

{% endmacro %}
