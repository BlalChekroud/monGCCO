{% if is_granted('ROLE_ADMIN') %}
<form method="post" action="{{ path('app_bird_life_tax_treat_delete', {'id': bird_life_tax_treat.id}) }}" onsubmit="return confirm('{{'delete_confirm'|trans }}');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ bird_life_tax_treat.id) }}">
    <button class="btn btn-danger btn-sm bi bi-trash-fill mx-2" title="{{ 'birdLifeTaxTreat.delete'|trans }}"></button>
</form>
