{% extends 'base.html.twig' %}

{% block title %}{{ 'breadcrumb_home'|trans }}{% endblock %}

{% block body %}
  <main id="main" class="main">

    <div class="pagetitle">
      <h1>{{ 'home_page'|trans }}</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item active">
            <a href="{{ path('home') }}"><i class="ri-home-4-line"></i> {{ 'breadcrumb_home'|trans }}</a>
          </li>
        </ol>
      </nav>
    </div><!-- End Page Title -->
    {% if campaigns %}
    <section class="section dashboard">
      <div class="row">

        <!-- Left side columns -->
        <div class="col-lg-8">
          <div class="row">

            <!-- Total Birds Card -->
            <div class="col-xxl-6 col-md-6">
              <div class="card info-card sales-card">
                <div class="card-body">
                  <h5 class="card-title">Total d'espèces observées <span class="explanation"><br/>({{ recentCampaign.campaignName }})</span></h5>
                  <div class="d-flex align-items-center">
                    <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                      <i class="ri-stack-line" style="color: #ffc107;"></i>
                    </div>
                    <div class="ps-3">
                      <h6>{{ totalBirdsCountedInCampaign ?? 0 }}</h6>
                    </div>
                  </div>
                </div>
              </div>
            </div><!-- End Total Birds Card -->

            <!-- Total Unique Species Card -->
            <div class="col-xxl-6 col-md-6">
              <div class="card info-card revenue-card">
                <div class="card-body">
                  <h5 class="card-title">Total d'espèces uniques observées <span class="explanation"><br/>({{ recentCampaign.campaignName }})</span></h5>
                  <div class="d-flex align-items-center">
                    <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                      <i class="ri-twitter-fill" style="color: #2eca6a;"></i>
                    </div>
                    <div class="ps-3">
                      <h6>{{ totalcountUniqueBirdSpeciesInCampaign }}</h6>
                    </div>
                  </div>
                </div>
              </div>
            </div><!-- End Total Unique Species Card -->
            
            <!-- Column Chart -->
            <div class="col-12">
              <div class="card">
                <div class="card-body">
                  <h5 class="card-title">{{ recentCampaign.campaignName }} <span>/ Aujourd'hui</span></h5>
                  <!-- Column Chart -->
                  <div id="columnChart"></div>

                  <script>
                    document.addEventListener("DOMContentLoaded", () => {
                      new ApexCharts(document.querySelector("#columnChart"), {
                        series: [
                          {
                            name: 'Total des oiseaux Comptés',
                            data: [
                              {% for site in siteCollectionsByCampaign %}
                                {{ totalBirdsCountPerSitesInCamapign[site.id] ?? 0 }},
                              {% endfor %}
                            ],
                          },
                          {
                            name: 'Total d\'espèces d\'oiseaux uniques observées',
                            data: [{{ uniqueBirdSpeciesCountForSiteInCampaign|join(', ') }}],
                          },
                        ],
                        chart: {
                          type: 'bar',
                          height: 350,
                        },
                        plotOptions: {
                          bar: {
                            horizontal: false,
                            columnWidth: '55%',
                            endingShape: 'rounded',
                          },
                        },
                        dataLabels: {
                          enabled: false,
                        },
                        stroke: {
                          show: true,
                          width: 2,
                          colors: ['transparent'],
                        },
                        xaxis: {
                          categories: [
                            {% for site in siteCollectionsByCampaign %}
                              "{{ site.siteName }}",
                            {% endfor %}
                          ],
                        },
                        yaxis: {
                          title: {
                            text: 'Total des oiseaux comptés',
                          },
                        },
                        fill: {
                          opacity: 1,
                        },
                        tooltip: {
                          y: {
                            formatter: function(val) {
                              return val + " oiseaux";
                            },
                          },
                        },
                      }).render();
                    });
                  </script>
                  <!-- End Column Chart -->

                </div>
              </div>
            </div><!-- End Column Chart -->

            <!-- Reports -->
            <div class="col-12">
              <div class="card">

                <div class="filter">
                  <a class="icon" href="#" data-bs-toggle="dropdown"><i class="bi bi-three-dots"></i></a>
                  <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                    <li class="dropdown-header text-start">
                      <h6>Filter</h6>
                    </li>

                    <li><a class="dropdown-item" href="#">Today</a></li>
                    <li><a class="dropdown-item" href="#">This Month</a></li>
                    <li><a class="dropdown-item" href="#">This Year</a></li>
                  </ul>
                </div>

                <div class="card-body">
                  <h5 class="card-title">Rapports <span>/Aujourd'hui</span></h5>

                  <!-- Line Chart -->
                  <div id="reportsChart"></div>

                  <script>
                    document.addEventListener("DOMContentLoaded", () => {
                      new ApexCharts(document.querySelector("#reportsChart"), {
                        series: [{
                          name: 'Total d\'oiseaux',
                          data: [
                              {% for campaign in totalBirdsCountByCampaign %}
                                {{ campaign.totalBirdCount ?? 0 }},
                              {% endfor %}],
                        }, {
                          name: 'Total d\'espèces d\'oiseaux uniques observées',
                          data: [
                              {% for campaign in totalUniqueBirdSpeciesCountByCampaign %}
                                {{ campaign.uniqueBirdSpeciesCount ?? 0 }},
                              {% endfor %}
                          ]
                        }, 
                        ],
                        chart: {
                          height: 350,
                          type: 'area',
                          toolbar: {
                            show: false
                          },
                        },
                        markers: {
                          size: 4
                        },
                        colors: ['#4154f1', '#2eca6a', '#ff771d'],
                        fill: {
                          type: "gradient",
                          gradient: {
                            shadeIntensity: 1,
                            opacityFrom: 0.3,
                            opacityTo: 0.4,
                            stops: [0, 90, 100]
                          }
                        },
                        dataLabels: {
                          enabled: false
                        },
                        stroke: {
                          curve: 'smooth',
                          width: 2
                        },
                        xaxis: {
                          type: 'Date de fin de la campagne',
                          categories: [
                                        {% for campaign in totalBirdsCountByCampaign %}
                                          "{{ campaign.endDate ? campaign.endDate|date('d-m-Y') : '' }}"{% if not loop.last %},{% endif %}
                                        {% endfor %}
                          ],
                          title: {
                            text: 'Date de fin de la campagne',
                            style: { fontSize: '14px', fontWeight: 'bold', color: '#666' }
                          }
                        },
                        tooltip: {
                          x: {
                            format: 'dd/MM/yy'
                          },
                        }
                      }).render();
                    });
                  </script>
                  <!-- End Line Chart -->

                </div>

              </div>
            </div><!-- End Reports -->

            <!-- Recent Sales -->
            <div class="col-12">
              <div class="card recent-sales overflow-auto">
                <div class="card-body">
                  <h5 class="card-title">Campagnes récentes <span>| Aujourd'hui</span></h5>
                  <table class="table table-borderless datatable">
                    <thead>
                      <tr>
                        <th scope="col">#</th>
                        <th scope="col">Date de fin</th>
                        <th scope="col">Campagne de comptage</th>
                        <th scope="col">Nombre de sites impliqués</th>
                        <th scope="col">Statut</th>
                      </tr>
                    </thead>
                    <tbody>
                      {% for campaign in campaigns %}
                        <tr>
                          <th scope="row"><a href="#">{{ loop.index }}</a></th>
                          <td>{{ campaign.endDate ? campaign.endDate|date('Y-m-d H:i') : '' }}</td>
                          <td><a href="{{ path('app_counting_campaign_show', {'id': campaign.id}) }}" class="text-primary">{{ campaign.campaignName }}</a></td>
                          <td>{{ campaign.siteAgentsGroups|length }}</td>
                          <td>
                            {% set status_classes = {
                                1: 'primary',   
                                2: 'info',      
                                3: 'light',   
                                4: 'success', 
                                5: 'warning',    
                                6: 'secondary',   
                                7: 'dark'       
                            } %}
                            <div class="badge bg-{{ status_classes[campaign.campaignStatus.id] ?? 'secondary' }}">
                              {{ campaign.campaignStatus }}
                            </div>
                          </td>
                        </tr>
                      {% else %}
                        <tr><td colspan="5">Aucun enregistrement trouvé</td></tr>
                      {% endfor %}
                    </tbody>
                  </table>
                </div>
              </div>
            </div><!-- End Recent Sales -->

          </div>
        </div><!-- End Left side columns -->

        <!-- Right side columns -->
        <div class="col-lg-4"> 
              <div class="card">
                  <div class="card-body">
                      <h5 class="card-title">Les espèces les plus comptées dans <span class="explanation">({{ recentCampaign.campaignName }})</span></h5>

                      <div id="carouselExampleCaptions" class="carousel slide" data-bs-ride="carousel">
                          <div class="carousel-indicators">
                              {% for specy in topThreeBirdSpeciesInCampaign %}
                                  <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="{{ loop.index0 }}" class="{% if loop.first %}active{% endif %}" aria-current="true" aria-label="Slide {{ loop.index }}"></button>
                              {% endfor %}
                          </div>

                          <div class="carousel-inner">
                              {% for specy in topThreeBirdSpeciesInCampaign %}

                                  <div class="carousel-item {% if loop.first %}active{% endif %}">
                                    {% if specy.imagePath %}
                                      {% for bird in bird_species %}
                                        {% if bird.scientificName == specy.scientificName %}
                                          <img src="{{ vich_uploader_asset(bird.image, 'imageFile') }}" class="d-block w-100" alt="{{ specy.scientificName }}">
                                        {% endif %}
                                      {% endfor %}
                                    {% else %}
                                        <p class="explanation">{{ "image.not_available"|trans }} pour {{ specy.scientificName }}</p>
                                        <p class="explanation">Total compté : {{ specy.topThreeCount }}</p>
                                    {% endif %}
                                    <div class="carousel-caption d-none d-md-block">
                                        <h5 class="text-shadow">{{ specy.scientificName }}</h5>
                                        <p class="text-shadow">Total compté : {{ specy.topThreeCount }}</p>
                                    </div>

                                </div>

                              {% endfor %}
                          </div>

                          <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="prev">
                              <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                              <span class="visually-hidden">Previous</span>
                          </button>
                          <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="next">
                              <span class="carousel-control-next-icon" aria-hidden="true"></span>
                              <span class="visually-hidden">Next</span>
                          </button>
                      </div>
                  </div>
              </div>        
              <div class="card">
                <div class="card-body">
                  <h5 class="card-title">Statistiques de total d'espèces observées par site <span class="explanation">({{ recentCampaign.campaignName }})</span></h5>

                  <!-- Pie Chart -->
                  <div id="pieChart"></div>

                  <script>
                    document.addEventListener("DOMContentLoaded", () => {
                      new ApexCharts(document.querySelector("#pieChart"), {
                        series: [
                                  {% for site in siteCollectionsByCampaign %}
                                    {{ totalBirdsCountPerSitesInCamapign[site.id] ?? 0 }},
                                  {% endfor %}],
                        chart: {
                          height: 350,
                          type: 'pie',
                          toolbar: {
                            show: true
                          }
                        },
                        labels: [
                                  {% for site in siteCollectionsByCampaign %}
                                    "{{ site.siteName }}",
                                  {% endfor %}]
                      }).render();
                    });
                  </script>
                  <!-- End Pie Chart -->

                </div>
              </div>
        
        </div><!-- End Right side columns -->

    </section>
    {% endif %}

  </main><!-- End #main -->
{% endblock %}
