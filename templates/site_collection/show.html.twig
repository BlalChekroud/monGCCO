{% extends 'base.html.twig' %}

{% block title %}{{'site_collection.title'|trans }}{% endblock %}

{% block body %}
<main id="main" class="main">

    <div class="pagetitle">
      <h1>{{'site_collection.title_show'|trans }}</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="{{ path('home') }}"><i class="ri-home-4-line"></i> {{ 'breadcrumb_home'|trans }}</a></li>
          <li class="breadcrumb-item"><a href="{{ path('app_site_collection_index') }}">{{ 'site_collection.manage'|trans }}</a></li>
          <li class="breadcrumb-item active">{{'show'|trans }}</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
        <div class="row">
            <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">

                <div class="card">
                    <div class="card-body">
                      <div id="printableArea">
                        <h5 class="card-title">{{'show'|trans }}</h5>

                        <table class="table">
                            <tbody>
                                <tr>
                                    <th>{{'site_collection.siteName'|trans }}</th>
                                    <td>{{ site_collection.siteName }}</td>
                                </tr>
                                <tr>
                                    <th>{{'site_collection.siteCode'|trans }}</th>
                                    <td>{{ site_collection.siteCode }}</td>
                                </tr>
                                <tr>
                                    <th>{{ 'created_at'|trans }}</th>
                                    <td>{{ site_collection.createdAt ? site_collection.createdAt|date('d-m-Y H:i:s') : '' }}</td>
                                </tr>
                                <tr>
                                    <th>{{ 'Last_updated_at'|trans }}</th>
                                    <td>{{ site_collection.updatedAt ? site_collection.updatedAt|date('d-m-Y H:i:s') : '' }}</td>
                                </tr>
                                <tr>
                                    <th>{{'site_collection.nationalSiteCode'|trans }}</th>
                                    <td>{{ site_collection.nationalSiteCode }}</td>
                                </tr>
                                <tr>
                                    <th>{{'site_collection.internationalSiteCode'|trans }}</th>
                                    <td>{{ site_collection.internationalSiteCode }}</td>
                                </tr>
                                <tr>
                                    <th>{{'site_collection.latDepart'|trans }}</th>
                                    <td>{{ site_collection.latDepart }}</td>
                                </tr>
                                <tr>
                                    <th>{{'site_collection.longDepart'|trans }}</th>
                                    <td>{{ site_collection.longDepart }}</td>
                                </tr>
                                <tr>
                                    <th>{{'site_collection.latFin'|trans }}</th>
                                    <td>{{ site_collection.latFin }}</td>
                                </tr>
                                <tr>
                                    <th>{{'site_collection.longFin'|trans }}</th>
                                    <td>{{ site_collection.longFin }}</td>
                                </tr>
                                <tr>
                                    {% set city = site_collection.city %}
                                    <th>{{'city.name'|trans }}</th>
                                    <td>{{ city.name }}</td>
                                </tr>
                                <tr>
                                    <th>{{'region.name'|trans }}</th>
                                    <td>{{ city.region.name }}
                                        {% if city.region.name %}
                                            {{ city.region.name }}
                                        {% else %}
                                            <span>{{'region.none'|trans }}</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                <tr>
                                    <th>{{'country.name'|trans }}</th>
                                    <td>
                                        {% if city.region.country %}
                                            {{ city.region.country.name }}
                                        {% else %}
                                            <span>{{'country.none'|trans }}</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                <tr>
                                    <th>{{'site_collection.parentSite'|trans }}</th>
                                    <td>{{ site_collection.parentSite ? site_collection.parentSite.siteName : '' }}</td>
                                </tr>
                                <tr>
                                    <th>{{'site_collection.parentOfSites'|trans }}</th>
                                    <td>
                                        {% if site_collection.siteCollections|length > 0 %}
                                            <ul>
                                                {% for subSite in site_collection.siteCollections %}
                                                    <li>{{ subSite.siteName }}</li>
                                                {% endfor %}
                                            </ul>
                                        {% else %}
                                            {{'site_collection.none'|trans }}
                                        {% endif %}
                                    </td>
                                </tr>
                                <tr>
                                    <th>{{'site_collection.uniqueBirdSpeciesCount'|trans }}</th>
                                    <td>
                                        {{ uniqueSpeciesCount ?? 0 }}
                                    </td>
                                </tr>
                                <tr>
                                    <th>{{'campaign_statistics.total_birds_counted'|trans }}</th>
                                    <td>
                                        {{ totalBirdCountsForSite ?? 0 }}
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                      </div>
                    </div>
                    <div class="card-footer d-flex justify-content-between">
                        <div>
                            <a href="{{ path('app_site_collection_index') }}" class="btn btn-sm btn-outline-secondary mx-1" title="{{ 'site_collection.return'|trans }}">{{ 'back'|trans }}</a>
                            <a href="{{ path('app_site_collection_new') }}" class="btn btn-outline-info btn-sm bi bi bi-geo-alt-fill mx-2"> {{ 'site_collection.add_collection_site'|trans }}</a>
                        </div>
                        <div class="d-flex justify-content-end">
                            {% import 'macros/btn_actions_macros.html.twig' as macros %}
                            {{ macros.action_buttons('app_site_collection_new','app_site_collection_show', 'app_site_collection_edit', 'site_collection/_delete_form.html.twig', site_collection, app.request.attributes.get('_route')) }}
                            {{ include('site_collection/_delete_form.html.twig') }}
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </section>
</main>
{% endblock %}
