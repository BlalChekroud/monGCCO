{% extends 'base.html.twig' %}

{% block title %}{{'site_collection.title'|trans }}{% endblock %}

{% block body %}
  <main id="main" class="main">

    <div class="pagetitle">
      <h1>{{'site_collection.title'|trans }}</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="{{ path('home') }}"><i class="ri-home-4-line"></i> {{ 'breadcrumb_home'|trans }}</a></li>
          <li class="breadcrumb-item active">{{ 'site_collection.manage'|trans }}</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
      <div class="row">
        <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
          <div id="printableArea">
            <div class="card">
              <div class="card-body">
                <h5 class="card-title">{{ 'card_title'|trans }}</h5>

                <!-- Table with stripped rows -->
                <table class="table datatable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>{{'site_collection.siteName'|trans }}</th>
                            <th>{{'city.name'|trans }}</th>
                            <th>{{'region.name'|trans }}</th>
                            <th>{{'site_collection.parentSite'|trans }}</th>
                            <th>{{ 'actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for site_collection in site_collections %}
                        <tr>
                            <td>{{ site_collection.id }}</td>
                            <td>{{ site_collection.siteName }}</td>
                            <td>{{ site_collection.city.name }}</td>
                            <td>{{ site_collection.city.region.name }}</td>
                            <td>{{ site_collection.parentSite }}</td>
                            <td>
                                <div class="d-flex justify-content-end">
                                    {% import 'macros/btn_actions_macros.html.twig' as macros %}
                                    {{ macros.action_buttons('app_site_collection_new','app_site_collection_show', 'app_site_collection_edit', 'site_collection/_delete_form.html.twig', site_collection, app.request.attributes.get('_route'), true) }}
                                    {{ include('site_collection/_delete_form.html.twig') }}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="14">{{ 'no_record_found'|trans }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
              </div>
              
              <div class="card-footer d-flex justify-content-between">
                <a href="{{ path('app_site_collection_new') }}" class="btn btn-outline-info btn-sm bi bi bi-geo-alt-fill"> {{ 'site_collection.add_collection_site'|trans }}</a>
                <a href="{{ path('app_city_index') }}" class="btn btn-outline-info btn-sm bi bi-list-task mx-1"> {{'city.consult'|trans }}</a>
                <a href="{{ path('app_nature_reserve_index') }}" class="btn btn-outline-info btn-sm bi bi-list-task mx-1"> {{'consult_reserves'|trans }}</a>
                <a href="{{ path('app_counting_campaign_index') }}" class="btn btn-outline-info btn-sm bi bi-list-task mx-1"> {{ 'campaign.consult'|trans }}</a>
              </div>

            </div>
          </div>
        </div>
      </div>
    </section>
    
    {% import 'macros/form_macros.html.twig' as form_macros %}
    {{ form_macros.csv_import_form(form, 'app_site_collection_index', formExport, 'Import sites collection Data', 'Export sites collection Data') }}

    {% if headers is defined and rows is defined %}
        {{ form_macros.csv_modal(headers, rows, csvData, 'app_site_collection_index', ['siteName', 'siteCode', 'latDepart', 'longDepart', 'latFin', 'longFin', 'city'], ['nationalSiteCode', 'internationalSiteCode', 'cityLat', 'cityLong', 'region']) }}
    {% endif %}

  </main><!-- End #main -->
{% endblock %}
