{% if is_granted('ROLE_ADMIN') %}
<form method="post" action="{{ path('app_site_collection_delete', {'id': site_collection.id}) }}" onsubmit="return confirm('{{ 'delete_confirm'|trans }}');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ site_collection.id) }}">
    <button class="btn btn-danger btn-sm bi bi-trash mx-2" title="{{ 'site_collection.delete'|trans }}"></button>
</form>
{% endif %}