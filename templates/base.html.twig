          {% set notifications = app.flashes() %}
          <script>
            {% for type, messages in notifications %}
                {% for message in messages %}
                    {% if type == 'success' %}
                        Swal.fire({
                            position: "top-end",
                            icon: "success",
                            title: "{{ message }}",
                            showConfirmButton: false,
                            timerProgressBar: true,
                            timer: 3000
                        });
                    {% elseif type == 'warning' %}
                        Swal.fire({
                            icon: "warning",
                            title: "Attention",
                            text: "{{ message }}"
                        });
                    {% elseif type == 'danger' %}
                        Swal.fire({
                            icon: "danger",
                            title: "Danger",
                            text: "{{ message }}"
                        });
                    {% elseif type == 'error' %}
                        Swal.fire({
                            icon: "error",
                            title: "Erreur",
                            text: "{{ message }}"
                        });
                    {% else %}
                        Swal.fire({
                            icon: "info",
                            title: "Info",
                            text: "{{ message }}"
                        });
                    {% endif %}
                {% endfor %}
            {% endfor %}
          </script>
