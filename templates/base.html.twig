          <li class="nav-item dropdown">
              <a class="nav-link nav-icon" href="#" data-bs-toggle="dropdown">
                  <i class="bi bi-bell"></i>
                  {% if notifications %}
                    {% for type, messages in notifications %}
                      {% for message in messages %}
                        {% if type == 'success' %}
                          <span class="badge bg-success badge-number">{{ notifications|length }}</span>
                        {% elseif type == 'warning' %}
                          <span class="badge bg-warning badge-number">{{ notifications|length }}</span>
                        {% elseif type == 'danger' %}
                          <span class="badge bg-danger badge-number">{{ notifications|length }}</span>
                        {% elseif type == 'error' %}
                          <span class="badge bg-warning badge-number">{{ notifications|length }}</span>
                        {% else %}
                          <span class="badge bg-info badge-number">{{ notifications|length }}</span>
                        {% endif %}
                      {% endfor %}
                    {% endfor %}
                  {% endif %}
              </a><!-- End Notification Icon -->
              <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow notifications">
                  <li class="dropdown-header">
                      {{ 'notification.you_have'|trans }} {{ notifications|length }} {{ 'notification.new_notification'|trans }}
                      {# <a href="{{ path('all_notifications') }}"><span class="badge rounded-pill bg-primary p-2 ms-2">Voir tout.</span></a> #}
                  </li>
                  <li>
                      <hr class="dropdown-divider">
                  </li>

                  {% for type, messages in notifications %}
                      {% for message in messages %}
                          <li class="notification-item">
                              {% if type == 'warning' %}
                                  <i class="bi bi-exclamation-circle text-warning"></i>
                              {% elseif type == 'danger' %}
                                  <i class="bi bi-x-circle text-danger"></i>
                              {% elseif type == 'error' %}
                                  <i class="bi bi-exclamation-circle text-warning"></i>
                              {% elseif type == 'success' %}
                                  <i class="bi bi-check-circle text-success"></i>
                              {% elseif type == 'info' %}
                                  <i class="bi bi-info-circle text-primary"></i>
                              {% endif %}
                              <div>
                                  <h4>{{ type|capitalize }}</h4>
                                  <p>{{ message }}</p>
                                  <p>{{ 'now'|date('H:i') }}</p>
                              </div>
                          </li>
                          <li>
                              <hr class="dropdown-divider">
                          </li>
                      {% endfor %}
                  {% endfor %}
                  
                  <li class="dropdown-footer">
                      {# <a href="{{ path('all_notifications') }}">Afficher toutes les notifications</a> #}
