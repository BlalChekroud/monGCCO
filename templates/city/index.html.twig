{% extends 'base.html.twig' %}

{% block title %}{{ 'city.title'|trans }}{% endblock %}

{% block body %}
    <main id="main" class="main">

        <div class="pagetitle">
        <h1>{{ 'city.title'|trans }}</h1>
        <nav>
            <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('home') }}"><i class="ri-home-4-line"></i> {{ 'breadcrumb_home'|trans }}</a></li>
            <li class="breadcrumb-item active">{{ 'city.manage'|trans }}</li>
            </ol>
        </nav>
        </div><!-- End Page Title -->

        <section class="section">
            <div class="row">
                <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">

                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">{{ 'card_title'|trans }}</h5>
                            <table class="table datatable">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>{{'city.name'|trans }}</th>
                                        <th>{{'latitude'|trans }}</th>
                                        <th>{{'longitude'|trans }}</th>
                                        <th>{{'region.name'|trans }}</th>
                                        <th>{{ 'created_at'|trans }}</th>
                                        <th>{{ 'actions'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                {% for city in cities %}
                                    <tr>
                                        <td>{{ city.id }}</td>
                                        <td>{{ city.name }}</td>
                                        <td>{{ city.latitude }}</td>
                                        <td>{{ city.longitude }}</td>
                                        <td>{{ city.region.name }}</td>
                                        <td>{{ city.createdAt ? city.createdAt|date('d-m-Y') : '' }}</td>
                                        <td>
                                            <div class="d-flex justify-content-end">
                                                {% import 'macros/btn_actions_macros.html.twig' as macros %}
                                                {{ macros.action_buttons('app_city_new','app_city_show', 'app_city_edit', 'city/_delete_form.html.twig', city, app.request.attributes.get('_route'), true) }}
                                                {{ include('city/_delete_form.html.twig') }}
                                            </div>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="7">{{ 'no_record_found'|trans }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        <div class="card-footer d-flex justify-content-between">
                            <a href="{{ path('app_city_new') }}" class="btn btn-outline-info btn-sm bi bi-plus-circle-dotted mx-1"> {{ 'add_a_city'|trans }}</a>
                            <a href="{{ path('app_site_collection_index') }}" class="btn btn-outline-info btn-sm bi bi bi-list-task mx-1"> {{ 'site_collection.consult'|trans }}</a>
                            {# <a href="{{ path('app_site_collection_new') }}" class="btn btn-outline-info btn-sm bi bi bi-geo-alt-fill"> {{ 'site_collection.add_collection_site'|trans }}</a> #}
                            <a href="{{ path('app_region_index') }}" class="btn btn-outline-info btn-sm bi bi-list-task mx-1"> {{ 'region.consult'|trans }}</a>
                            {# <a href="{{ path('app_region_new') }}" class="btn btn-outline-info btn-sm bi bi-plus-circle-dotted mx-1"> {{ 'add_a_region'|trans }}</a> #}
                            <a href="{{ path('app_country_index') }}" class="btn btn-outline-info btn-sm bi bi-list-task mx-1"> {{'country.consult'|trans }}</a>
                            {# <a href="{{ path('app_country_new') }}" class="btn btn-outline-info btn-sm bi bi-plus-circle-dotted mx-1"> {{ 'add_a_country'|trans }}</a> #}
                        </div>
                    </div>

                </div>
            </div>
        </section>

        {% import 'macros/form_macros.html.twig' as form_macros %}
        {{ form_macros.csv_import_form(form, 'app_city_index', formExport, 'Import cities Data', 'Export cities Data') }}

        {% if headers is defined and rows is defined %}
            {{ form_macros.csv_modal(headers, rows, csvData, 'app_city_index', ['city', 'lat', 'lng', 'region', 'regionCode'], ['country']) }}
        {% endif %}

    </main><!-- End #main -->
{% endblock %}
