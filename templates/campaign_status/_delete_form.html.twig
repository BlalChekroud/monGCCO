{% if is_granted('ROLE_SUPER_ADMIN') %}
    <form method="post" action="{{ path('app_campaign_status_delete', {'id': campaign_status.id}) }}" onsubmit="return confirm('{{ 'delete_confirm'|trans }}');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ campaign_status.id) }}">
        <button class="btn btn-danger btn-sm bi bi-trash mx-2" title="{{ 'campaignStatus.delete'|trans }}"></button>
    </form>
{% endif %}
