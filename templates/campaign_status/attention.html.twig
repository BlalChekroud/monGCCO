<div class="modal-header bg-info">
    <h5 class="modal-title bi bi-book"> {{ 'campaignGuide.title'|trans }}</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'campaignGuide.close'|trans }}"></button>
</div>
<div class="modal-body">
    <h6>{{ 'campaignGuide.introductionTitle'|trans }}</h6>
    <p>
        {{ 'campaignGuide.introductionText'|trans }}
    </p>
    <h6>{{ 'campaignGuide.differentStatesTitle'|trans }}</h6>
    <ol>

        {% set keys = ['planned', 'ongoing', 'finished', 'closed', 'error', 'suspended', 'cancelled'] %}
        {% for i, status in campaign_statuses %}
            <li>
                <strong>{{ status.label }}</strong> : 
                {{ ('campaignGuide.state.' ~ keys[i] ~'.description')|trans }}
                <ul>
                    <li>
                        <strong>{{ ('campaignGuide.common.active')|trans }}</strong> 
                        {{ ('campaignGuide.state.' ~ keys[i] ~'.active_description')|trans }}
                    </li>
                    {% if keys[i] not in ['closed', 'error'] %}
                        <li>
                            <strong>{{ ('campaignGuide.common.actions')|trans }}</strong> 
                            {{ ('campaignGuide.state.' ~ keys[i] ~'.actions_description')|trans }}
                        </li>
                    {% endif %}
                </ul>
            </li>
        {% endfor %}
    </ol>

    <h6>{{ 'campaignGuide.adviceTitle'|trans }}</h6>
    <ul>
        <li>
            <strong>{{ 'campaignGuide.advice.close.title'|trans }}</strong> 
            {{ 'campaignGuide.advice.close.description'|trans }}
        </li>
        <li>
            <strong>{{ 'campaignGuide.advice.resume.title'|trans }}</strong> 
            {{ 'campaignGuide.advice.resume.description'|trans }}
        </li>
        <li>
            <strong class="text-danger">{{ 'campaignGuide.advice.cancel.title'|trans }}</strong> 
            {{ 'campaignGuide.advice.cancel.description'|trans }}
        </li>
    </ul>
</div>
