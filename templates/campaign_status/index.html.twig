{% extends 'base.html.twig' %}

{% block title %}{{'campaignStatus.title'|trans }}{% endblock %}

{% block body %}
<main id="main" class="main">

    <div class="pagetitle">
        <h1>{{'campaignStatus.title'|trans }}</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('home') }}"><i class="ri-home-4-line"></i> {{ 'breadcrumb_home'|trans }}</a></li>
                <li class="breadcrumb-item active">{{'campaignStatus.manage'|trans }}</li>
            </ol>
        </nav>
    </div><!-- End Page Title -->

    <section class="section">
        <div class="row">
            <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <h5 class="card-title">{{ 'card_title'|trans }}</h5>
                            <button type="button" class="btn btn-sm btn-info bi bi-book" data-bs-toggle="modal" data-bs-target="#largeModal"> {{'help'|trans }}</button>
                            
                            <!-- Large Modal for AIDE -->
                            <div class="modal fade" id="largeModal" tabindex="-1">
                                <div class="modal-dialog modal-lg">
                                    <div class="modal-content">
                                        {% include("campaign_status/attention.html.twig") %}
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-sm btn-secondary bi bi-x-lg" data-bs-dismiss="modal" title="{{'close'|trans }}"></button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div id="printableArea">
                            <table class="table datatable">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>{{'label'|trans }}</th>
                                        <th>{{ 'created_at'|trans }}</th>
                                        <th>{{ 'Last_updated_at'|trans }}</th>
                                        <th>{{ 'actions'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for campaign_status in campaign_statuses %}
                                    <tr>
                                        <td>{{ campaign_status.id }}</td>
                                        <td>{{ campaign_status.label }}</td>
                                        <td>{{ campaign_status.createdAt ? campaign_status.createdAt|date('d-m-Y H:i:s') : '' }}</td>
                                        <td>{{ campaign_status.updatedAt ? campaign_status.updatedAt|date('d-m-Y H:i:s') : '' }}</td>
                                        <td>
                                            <div class="d-flex justify-content-center">
                                                {% import 'macros/btn_actions_macros.html.twig' as macros %}
                                                {{ macros.action_buttons('app_campaign_status_new', 'home', 'app_campaign_status_edit', 'campaign_status/_delete_form.html.twig', campaign_status, app.request.attributes.get('_route')) }}
                                                {{ include('campaign_status/_delete_form.html.twig') }}
                                            </div>
                                        </td>
                                    </tr>
                                    {% else %}
                                    <tr>
                                        <td colspan="5">{{ 'no_record_found'|trans }}</td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>

                    </div>
                    <div class="card-footer">
                        <a href="{{ path('app_campaign_status_new') }}" class="btn btn-outline-info btn-sm bi bi-plus-circle-dotted"> {{'add_a_campaignStatus'|trans }}</a>
                        <a href="{{ path('app_counting_campaign_new') }}" class="btn btn-outline-info btn-sm bi bi-plus-circle-dotted mx-1"> {{ 'campaign.create_campaign'|trans }}</a>
                        <a href="{{ path('app_counting_campaign_index') }}" class="btn btn-outline-info btn-sm bi bi-list-task mx-1"> {{'campaign.consult'|trans }}</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main><!-- End #main -->
{% endblock %}
