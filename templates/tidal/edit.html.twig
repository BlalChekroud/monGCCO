{% extends 'base.html.twig' %}

{% block title %}{{'conditionTidal.title'|trans }}{% endblock %}

{% block body %}
  <main id="main" class="main">

    <div class="pagetitle">
      <h1>{{ 'conditionTidal.title_edit'|trans }}</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="{{ path('home') }}"><i class="ri-home-4-line"></i> {{ 'breadcrumb_home'|trans }}</a></li>
          <li class="breadcrumb-item"><a href="{{ path('app_tidal_index') }}">{{ 'conditionTidal.manage'|trans }}</a></li>
          <li class="breadcrumb-item active">{{ 'modification'|trans }}</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
      <div class="row">
        <div class="col-sm-8 col-md-8 col-lg-8 col-xl-8">

          <div class="card">
            <div class="card-body">
              <h5 class="card-title">{{ 'conditionTidal.the_new_informations'|trans }}</h5>

              {{ include('tidal/_form.html.twig') }}

            </div>
            <div class="card-footer">
              <div class="d-flex justify-content-between">
                <div>
                  <a href="{{ path('app_tidal_index') }}" class="btn btn-sm btn-outline-secondary mx-1" title="{{ 'conditionTidal.return'|trans }}">{{ 'back'|trans }}</a>
                </div>
                <div class="d-flex justify-content-end">
                  {{ include('tidal/_delete_form.html.twig') }}
                </div>
              </div>
            </div>
          </div>

        </div>

      </div>
    </section>

  </main><!-- End #main -->
{% endblock %}
