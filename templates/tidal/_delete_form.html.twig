{% if is_granted('ROLE_DELETE') %}    
    <form method="post" action="{{ path('app_tidal_delete', {'id': tidal.id}) }}" onsubmit="return confirm('{{'delete_confirm'|trans }}');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ tidal.id) }}">
        <button class="btn btn-danger btn-sm bi bi-trash-fill mx-2" title="{{ 'conditionTidal.delete'|trans }}"></button>
    </form>
{% endif %}