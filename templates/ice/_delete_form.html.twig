{% if is_granted('ROLE_DELETE') %}
    <form method="post" action="{{ path('app_ice_delete', {'id': ice.id}) }}" onsubmit="return confirm('{{ 'delete_confirm'|trans }}');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ ice.id) }}">
        <button class="btn btn-danger btn-sm bi bi-trash-fill mx-2" title="{{ 'conditionIce.delete'|trans }}"></button>
    </form>
{% endif %}