{% extends 'base.html.twig' %}

{% block title %}{{ 'birdSpecies.title'|trans }}{% endblock %}

{% block body %}
<main id="main" class="main">

    <div class="pagetitle">
      <h1>{{ 'birdSpecies.title_add'|trans }}</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="{{ path('home') }}"><i class="ri-home-4-line"></i> {{ 'breadcrumb_home'|trans }}</a></li>
          <li class="breadcrumb-item"><a href="{{ path('app_bird_species_index') }}">{{ 'birdSpecies.title'|trans }}</a></li>
          <li class="breadcrumb-item active">{{ 'add'|trans }}</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
        <div class="row">
            <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">

                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">{{ 'birdSpecies.informations'|trans }}</h5>

                        {{ include('bird_species/_form.html.twig') }}

                    </div>
                    <div class="card-footer">
                        <a href="{{ path('app_bird_species_index') }}" class="btn btn-sm btn-outline-secondary mx-1" title="{{ 'birdSpecies.return'|trans }}">{{ 'back'|trans }}</a>
                        <a href="{{ path('app_bird_family_new') }}" class="btn btn-outline-info btn-sm bi bi-plus-circle-dotted"> {{ 'create_a_family'|trans }}</a>
                    </div>
                </div>

            </div>

        </div>
    </section>
</main>


{% endblock %}
